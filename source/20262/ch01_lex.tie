type tie<logic>
// ch01_lex.tie —— 规范正文 · 第 1 章 词法与记号
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch01 {

pub func chapter() {
    dp.h1("第 1 章  词法与记号")

    dp.p("本章定义一个 tie 源文件的物理形态：如何组织、如何切分为记号、哪些记号有意义。词法层是其余一切章节的基础——语法分析只看到本章定义的记号流，而不关心源文件的字节细节。")

    // ---------------- 1.1 ----------------
    dp.h2("1.1  源文件结构：头部与内容")
    dp.p("一个 tie 源文件由两部分组成：头部声明本文件是什么，内容承载真正的代码或数据。两者职责分离，头部只占最前面几行。")
    dp.codeblock(dp.src(["type tie<logic>          // 头部：声明文件角色", "                        // （其后为内容区）", "func main() " + lb() + "", "    println(\"hello\")", "" + rb() + ""]))
    dp.p("头部是真正的语法行，而不再是以注释形式书写的编译器指令。头部必须位于文件最前若干行，连续排列（其间允许空行），直到第一个非头部行为止。")

    dp.h3("头部语法")
    dp.p("头部由关键字 type、语言名 tie 与可选的尖括号子类型构成。子类型写在尖括号内；带参数的角色再用冒号给出参数，多个修饰用逗号分隔。")
    dp.codeblock(dp.src(["type tie                       // 裸形式：Type 角色本身", "type tie<logic>                // 带子类型的完整形式", "type tie<db: vector, unsafe>   // 带参数与修饰"]))
    dp.p("若文件未声明头部，按 logic 处理。文件名可以采用 xxx.角色.tie 的形式声明默认角色；当文件名与头部声明不一致时，以头部为准并给出一条警告。这样既允许用文件名快速辨别用途，又不让文件名凌驾于显式声明之上。")

    // ---------------- 1.2 ----------------
    dp.h2("1.2  文件角色")
    dp.p("角色决定编译器如何解析与生成该文件。它是文件的第一属性，决定了后续内容允许出现什么构造。")

    var w = table_new_i64()
    table_push(w, 120)
    table_push(w, 331)
    var hdr = table_new_string()
    table_push(hdr, "头部")
    table_push(hdr, "角色与允许的内容")
    var rows: table<table<string>> = []
    table_push(rows, dp.kvrow("type tie<logic>", "逻辑代码。可含函数、结构、模块级声明；可编译为可执行程序或静态库。默认角色。"))
    table_push(rows, dp.kvrow("type tie<class>", "类库文件。与逻辑代码同为可执行语义，但只编译为静态库，不产生入口。"))
    table_push(rows, dp.kvrow("type tie<script>", "脚本。顶层语句按书写顺序直接执行，不要求显式入口。"))
    table_push(rows, dp.kvrow("type tie<data>", "纯数据。只允许数据声明与字面量，不允许函数体；可被其他文件导入作为常量源。"))
    table_push(rows, dp.kvrow("type tie<ui>", "界面文件。声明界面单元树与交互契约，由编译器生成界面代码（见第 14 章）。"))
    table_push(rows, dp.kvrow("type tie<db>", "数据库文件。声明表结构与查询，编译器生成建表与读写代码。"))
    table_push(rows, dp.kvrow("type tie<port>", "接口文件。声明对外契约，不含实现。"))
    table_push(rows, dp.kvrow("type tie<ir>", "中间表示文件。直接产出中间代码，不再经过后续优化与链接阶段。"))
    table_push(rows, dp.kvrow("type tie<test>", "测试文件。只做检查与执行，不产出交付物。"))
    table_push(rows, dp.kvrow("type tie<bench>", "基准文件。用于性能测量。"))
    table_push(rows, dp.kvrow("type tie<zd>", "结构化二进制数据文件——数据格式的二进制变体（见第 9 章）。"))
    table_push(rows, dp.kvrow("type tie<tsh>", "终端脚本文件，由终端脚本宿主执行（见第 15 章）。"))
    dp.tbl(hdr, rows, w)

    dp.h3("修饰角色")
    dp.p("修饰角色与基础角色并列书写，用于收紧或放宽该文件的语义边界。")
    var w2 = table_new_i64()
    table_push(w2, 120)
    table_push(w2, 331)
    var hdrm = table_new_string()
    table_push(hdrm, "修饰")
    table_push(hdrm, "作用")
    var rowsm: table<table<string>> = []
    table_push(rowsm, dp.kvrow("unsafe", "整个文件处于不安全上下文。用于平台桥接与外部接口封装这类必须直接操作内存的模块。"))
    table_push(rowsm, dp.kvrow("owned", "声明该文件的依赖归本项目所有（非外部依赖）。"))
    table_push(rowsm, dp.kvrow("embedded", "目标为嵌入式场景，约束可用特性与运行时设施。"))
    dp.tbl(hdrm, rowsm, w2)

    dp.p("角色集是开放的：项目可以在自己的角色注册文件里声明自定义角色，使工程可以按领域细分文件的编译策略。")
    dp.note("角色不是注释、不是标记，而是编译器分派解析与生成策略的依据。这正是头部必须在最前面、且被词法层正式识别的原因。")

    // ---------------- 1.3 ----------------
    dp.h2("1.3  字符集与编码")
    dp.p("源文件以 UTF-8 编码。字符串内部同样以 UTF-8 存储，但语言层面区分两个尺度：")
    dp.bullet(["s.len() / s.char(i) —— 以码点为单位。中文、emoji 都算一个。", "len(s) —— 以字节为单位。一个汉字占 3 字节。"])
    dp.p("遍历文本一律使用码点尺度；按字节遍历会把多字节字符切碎。这一约定贯穿标准库的文本处理函数。")
    dp.codeblock(dp.src(["var s = \"你好\"", "s.len()       // 2   码点", "len(s)           // 6   字节", "s.char(0)   // \"你\""]))

    // ---------------- 1.4 ----------------
    dp.h2("1.4  注释")
    dp.p("注释有三种形态，前两种在词法阶段被丢弃，不进入记号流；第三种会附着到声明上。")
    dp.codeblock(dp.src(["// 行注释：自 // 起至本行结束", "/* 块注释：可跨行 */", "/// 文档注释：附着到紧随其后的声明"]))
    dp.p("文档注释可被工具提取，用于生成接口文档。它比普通注释有更强的归属语义：紧接在某个声明之前，就属于那个声明；写在函数体内部则退化为普通注释。")

    // ---------------- 1.5 ----------------
    dp.h2("1.5  标识符")
    dp.p("标识符由字母、下划线或 Unicode 字母开头，其后可接字母、数字与下划线。语言接受 Unicode 标识符，中文可以直接用作标识符。")
    dp.codeblock(dp.src(["count, _tmp, 用户数, 结果1"]))
    dp.p("约定：类型名以大写字母开头，函数与变量以小写字母或下划线开头。这是约定而非强制，编译器不做检查，但工具链会据此提供提示。")

    // ---------------- 1.6 ----------------
    dp.h2("1.6  关键字")
    dp.p("关键字是保留字，不可用作标识符。它们按用途分组如下。")
    var w3 = table_new_i64()
    table_push(w3, 130)
    table_push(w3, 321)
    var h3k = table_new_string()
    table_push(h3k, "用途")
    table_push(h3k, "关键字")
    var r3: table<table<string>> = []
    table_push(r3, dp.kvrow("声明", "var const func struct enum namespace port interface impl import as pub using extern macro alias actor extends"))
    table_push(r3, dp.kvrow("类型", "i8 i16 i32 i64 u8 u16 u32 u64 i128 u128 f32 f64 bool trit char string void code table map num text misc any"))
    table_push(r3, dp.kvrow("语句", "if else while for in switch case default when break continue return yield goto"))
    table_push(r3, dp.kvrow("修饰与更新", "ref immut move inline repr unsafe const async with"))
    table_push(r3, dp.kvrow("字面量", "true false zero"))
    table_push(r3, dp.kvrow("并发与故障", "panic"))
    table_push(r3, dp.kvrow("内联汇编", "asm"))
    dp.tbl(h3k, r3, w3)
    dp.note("关键字表是封闭的：新关键字只在语言版本升级时加入。语言另有一批只在特定位置被识别的词（见 1.13），它们不是保留字，但同样不宜用作标识符。")

    // ---------------- 1.7 ----------------
    dp.h2("1.7  数值字面量")
    dp.p("整数支持五种进制，允许用下划线分组以提高可读性。小数与指数形式构成浮点字面量。字面量可带类型后缀，显式指定其类型。")
    var w4 = table_new_i64()
    table_push(w4, 170)
    table_push(w4, 281)
    var h4k = table_new_string()
    table_push(h4k, "形态")
    table_push(h4k, "含义")
    var r4: table<table<string>> = []
    table_push(r4, dp.kvrow("42", "十进制整数，默认类型 i64"))
    table_push(r4, dp.kvrow("0xFF / 0xff", "十六进制"))
    table_push(r4, dp.kvrow("0b1011", "二进制"))
    table_push(r4, dp.kvrow("0o755", "八进制"))
    table_push(r4, dp.kvrow("0t1T0", "平衡三进制（数字 0 / 1 / T，T 表示 -1）"))
    table_push(r4, dp.kvrow("1_000_000", "下划线分组，等价于 1000000"))
    table_push(r4, dp.kvrow("0xCA_FE", "分组在各进制中均可"))
    table_push(r4, dp.kvrow("3.14 / 1.5e3", "浮点，默认类型 f64"))
    table_push(r4, dp.kvrow("1.2f32 / 42i32 / 0x80u16", "带类型后缀，显式指定类型"))
    table_push(r4, dp.kvrow("-1t / 0t / 1t", "三值字面量（等价于 false / zero / true）"))
    dp.tbl(h4k, r4, w4)

    // ---------------- 1.8 ----------------
    dp.h2("1.8  布尔与三值字面量")
    dp.p("true 与 false 构成布尔类型。语言另有一个三值类型 trit，取值为正、零、负，其字面量复用 true / zero / false，在 trit 上下文中适配为三值。")
    dp.codeblock(dp.src(["var b: bool = true", "var p: trit = true     // 正", "var z: trit = zero     // 零", "var n: trit = false    // 负"]))

    // ---------------- 1.9 ----------------
    dp.h2("1.9  字符与字符串字面量")
    dp.p("字符字面量以单引号界定，字符串字面量以双引号界定。字符串有四种形态，各有其适用场合。四种形态里只有插值字符串会求值花括号内的表达式，而它必须以 h 前缀显式标出——花括号是否被当作替换点，看字面量的头一个字符就知道。")
    var w5 = table_new_i64()
    table_push(w5, 165)
    table_push(w5, 286)
    var h5 = table_new_string()
    table_push(h5, "形态")
    table_push(h5, "适用场合")
    var r5: table<table<string>> = []
    table_push(r5, dp.kvrow("普通字符串 \"...\"", "转义生效；花括号原样保留。日常使用。"))
    table_push(r5, dp.kvrow("原始字符串 r\"...\"", "转义不生效、无插值。写路径、正则、含反斜杠的内容用它，省去双重转义。"))
    table_push(r5, dp.kvrow("多行字符串 \"\"\"...\"\"\"", "可跨行书写，按闭合引号的缩进剥离每行前缀。写 SQL、JSON、模板片段用它，不破坏源码缩进。"))
    table_push(r5, dp.kvrow("插值字符串 h\"..." + lb() + "e" + rb() + "...\"", "花括号内表达式求值后转为文本拼入；跨行时写作 h\"\"\"...\"\"\"，同样带插值。"))
    dp.tbl(h5, r5, w5)
    dp.codeblock(dp.src(["var c: char = 'A'", "var esc = \"tab:\\t quote:\\\" backslash:\\\\\"", "var raw = r\"C:\\path\\to\\file\"        // 无转义，原样保留", r"var plain = ""共 {n} 项""              // 花括号原样保留", r"var interp = h""共 {n} 项""            // 花括号内求值后拼入"]))
    dp.p("多行字符串按闭合引号所在行的缩进作基准，逐行剥离该前缀。这样源码可以在任何缩进层级书写 SQL 或 JSON 片段，而字符串内容本身保持左对齐。")
    dp.p("插值是显式开启的行为，不是普通字符串的隐含语义。含花括号的内容——JSON、模板片段、正则——因此可以照原样书写，不必担心被意外求值；确实要把运行时值拼进去时，才在引号前写上 h。h 不能与形态前缀 r 组合：原始字符串的用途正是「一个记号也不解释」，而 h 要求解释花括号。")
    dp.p("插值字符串里要写出字面的花括号时，写两个花括号代表一个；不带 h 的字符串没有这条规则，花括号即字面量。")
    dp.p("插值点可以携带格式说明符，写在表达式之后、以冒号分隔：花括号内写作「表达式:规格」。规格自左向右依次是对齐与填充、正负号、宽度、精度与类型，各段均可省略。有了它，数值的定点、补零、进制转换这类日常格式化就在插值里一并完成，不再需要单独的格式化函数族。")
    var w5b = table_new_i64()
    table_push(w5b, 170)
    table_push(w5b, 281)
    var h5b = table_new_string()
    table_push(h5b, "规格段")
    table_push(h5b, "含义")
    var r5b: table<table<string>> = []
    table_push(r5b, dp.kvrow("对齐与填充", "< 左对齐、^ 居中、> 右对齐；可在其前写一个填充字符，默认空格。"))
    table_push(r5b, dp.kvrow("符号", "+ 表示非负数也显式写出加号。"))
    table_push(r5b, dp.kvrow("宽度", "十进制整数，最小字符数，不足按对齐补齐。"))
    table_push(r5b, dp.kvrow("精度", ".n：浮点限定小数位，字符串限定最大长度。"))
    table_push(r5b, dp.kvrow("类型", "b 二进制、o 八进制、x 十六进制、e 科学计数、f 定点、% 百分比。"))
    dp.tbl(h5b, r5b, w5b)
    dp.codeblock(dp.src([r"h""{x:08.2f}""          // 定点两位小数，宽八，不足补零", r"h""{id:>6x}""            // 十六进制，右对齐，宽六", r"h""{ratio:%}""           // 百分比", r"h""{name:^10}""          // 字符串居中，宽十"]))

    // ---------------- 1.10 ----------------
    dp.h2("1.10  自动分号")
    dp.p("tie 不要求每条语句以分号结尾。编译器在词法阶段按规则补全语句结束，这一机制称为自动分号插入。")
    dp.bullet(["当一行结束后，若下一个记号不能延续当前语句，则在此处插入语句结束。", "当一行以逗号、二元运算符、左括号等「明显未结束」的记号结尾时，不插入。", "显式书写分号始终合法，可与自动补全混用。", "括号深度只统计圆括号与方括号；花括号是块边界，不计入。", "注释、字符串、插值块内部不参与该判定。"])
    dp.p("这条规则让代码更接近日常书写的文本，同时保持分析的确定性——判定只看记号，不依赖缩进或换行风格。")

    // ---------------- 1.11 ----------------
    dp.h2("1.11  行续行")
    dp.p("行尾写反斜杠表示「本行未结束」，下一行继续同一语句。它用于把长表达式拆成多行，且不依赖运算符的位置。")
    dp.codeblock(dp.src(["var total = first + \\", "    second + \\", "    third"]))
    dp.p("自动分号与续行是互补的两条规则：前者在语句该结束时补上结束符，后者明确表示此处不该结束。需要跨行书写的长表达式应当显式续行，而不依赖「行尾恰好是运算符」这一间接判据。")

    // ---------------- 1.12 ----------------
    dp.h2("1.12  运算符记号")
    dp.p("下表汇总全部运算符记号；含义与结合性见第 3 章，第 8 章给出记号一览与优先级表。")
    var w6 = table_new_i64()
    table_push(w6, 170)
    table_push(w6, 281)
    var h6 = table_new_string()
    table_push(h6, "记号")
    table_push(h6, "用途")
    var r6: table<table<string>> = []
    table_push(r6, dp.kvrow("+  -  *  /  %", "算术；取余"))
    table_push(r6, dp.kvrow("\\  %%", "整除；成对取余"))
    table_push(r6, dp.kvrow("**  **?", "幂；带检查的幂"))
    table_push(r6, dp.kvrow("+?  -?  *?  <<?", "带检查的加、减、乘与移位"))
    table_push(r6, dp.kvrow("==  !=  <  >  <=  >=", "比较（支持链式比较）"))
    table_push(r6, dp.kvrow("&&  ||  !", "逻辑（对三值为三值逻辑）"))
    table_push(r6, dp.kvrow("&  |  ^  <<  >>  ~", "位运算"))
    table_push(r6, dp.kvrow("=  +=  -=  *=  /=  %=  %%=", "赋值与复合赋值"))
    table_push(r6, dp.kvrow("\\=  &=  |=  ^=  <<=  >>=", "其余复合赋值"))
    table_push(r6, dp.kvrow("++  --", "自增与自减"))
    table_push(r6, dp.kvrow("->", "数据流管道；返回位；短闭包；分支臂"))
    table_push(r6, dp.kvrow("<-", "数据流反向赋值；反向解构"))
    table_push(r6, dp.kvrow("in  not in", "成员判定与取反"))
    table_push(r6, dp.kvrow("?:", "安全默认值"))
    table_push(r6, dp.kvrow("?  ?.  ?[", "存在判定与可空链访问"))
    table_push(r6, dp.kvrow("\\", "解引用（不安全上下文）"))
    table_push(r6, dp.kvrow("..  ..=", "范围（左闭右开 / 左闭右闭）"))
    table_push(r6, dp.kvrow("...", "变长形参、实参展开、解构剩余"))
    table_push(r6, dp.kvrow("@  #  $  `", "元素标记与注解、属性与标签、宏插值、准引用"))
    table_push(r6, dp.kvrow("with", "不可变更新"))
    table_push(r6, dp.kvrow("-|  <-|  ->x  ~x  -><", "图的边与节点操作（不安全上下文）"))
    dp.tbl(h6, r6, w6)

    // ---------------- 1.13 ----------------
    dp.h2("1.13  上下文关键字")
    dp.p("有一类词只在特定位置被识别为语法成分，其他位置是普通标识符。它们不计入保留字，但书写时不应作为变量名使用。")
    var w7 = table_new_i64()
    table_push(w7, 150)
    table_push(w7, 301)
    var h7 = table_new_string()
    table_push(h7, "词")
    table_push(h7, "识别位置")
    var r7: table<table<string>> = []
    table_push(r7, dp.kvrow("fn", "函数类型与函数修饰位置"))
    table_push(r7, dp.kvrow("let", "条件解构位置"))
    table_push(r7, dp.kvrow("not", "与 in 组合成成员取反"))
    table_push(r7, dp.kvrow("try", "错误聚合块位置"))
    table_push(r7, dp.kvrow("defer", "作用域收尾块位置"))
    table_push(r7, dp.kvrow("guard", "前置条件位置"))
    table_push(r7, dp.kvrow("run", "建立并发执行体的位置"))
    table_push(r7, dp.kvrow("self", "接收者位置"))
    table_push(r7, dp.kvrow("out / inout / target", "内联汇编操作数位置"))
    table_push(r7, dp.kvrow("array", "定长数组类型位置"))
    table_push(r7, dp.kvrow("r", "紧跟引号时表示原始字符串"))
    table_push(r7, dp.kvrow("h", "紧跟引号时表示插值字符串"))
    table_push(r7, dp.kvrow("type", "文件头部声明角色"))
    dp.tbl(h7, r7, w7)
    dp.note("把这批词与保留字分开列出，是因为二者的约束强度不同：保留字是硬约束（用作标识符即报错），上下文关键字是命名建议（用作标识符不报错，但在相应位置会产生歧义）。")
}

// 左右花括号的字符串形态（正文里展示字面花括号时用，避免被编译器当成插值求值）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
