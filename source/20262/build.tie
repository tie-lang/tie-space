type tie<logic>
// build.tie —— 《tie 语言语法规范 2026.2》构建入口
// ============================================================
// 两遍排版（目录页码必须回填，而页码又受目录自身占页数影响）：
//   阶段一：干跑（不产出内容）——收集章标题与页码，并量出目录占几页
//   阶段二：正式排版——封面 → 目录（真实页码）→ 正文
// 干跑与正式排版走同一份代码路径，故页码一致；无须迭代收敛。
//
// 生成：tiec build.tie -o build.exe && build.exe
// 编排：make.tsh.tie（tshell）
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp
import "F:/Projects/tie-repo/tofflib/spec/ch01_lex.tie" as c01
import "F:/Projects/tie-repo/tofflib/spec/ch02_types.tie" as c02
import "F:/Projects/tie-repo/tofflib/spec/ch03_expr.tie" as c03
import "F:/Projects/tie-repo/tofflib/spec/ch04_stmt.tie" as c04
import "F:/Projects/tie-repo/tofflib/spec/ch05_func.tie" as c05
import "F:/Projects/tie-repo/tofflib/spec/ch06_data.tie" as c06
import "F:/Projects/tie-repo/tofflib/spec/ch07_port.tie" as c07
import "F:/Projects/tie-repo/tofflib/spec/ch08_error.tie" as c08
import "F:/Projects/tie-repo/tofflib/spec/ch09_module.tie" as c09
import "F:/Projects/tie-repo/tofflib/spec/ch10_conc.tie" as c10
import "F:/Projects/tie-repo/tofflib/spec/ch11_unsafe.tie" as c11
import "F:/Projects/tie-repo/tofflib/spec/ch12_macro.tie" as c12
import "F:/Projects/tie-repo/tofflib/spec/ch13_move.tie" as c13
import "F:/Projects/tie-repo/tofflib/spec/ch14_ui.tie" as c14
import "F:/Projects/tie-repo/tofflib/spec/ch15_tool.tie" as c15
import "F:/Projects/tie-repo/tofflib/spec/ch16_ref.tie" as c16

const OUT: string = "F:/Projects/tie-repo/tofflib/spec/tie-spec-2026.pdf";

// 正文全部章节（两遍排版共用同一份调用序列）
func body() {
    c01.chapter()
    c02.chapter()
    c03.chapter()
    c04.chapter()
    c05.chapter()
    c06.chapter()
    c07.chapter()
    c08.chapter()
    c09.chapter()
    c10.chapter()
    c11.chapter()
    c12.chapter()
    c13.chapter()
    c14.chapter()
    c15.chapter()
    c16.chapter()
}

func main() -> i64 {
    dp.init()

    // ---------- 阶段一：干跑，收集标题与页码，量出目录页数 ----------
    dp.reset_doc()
    dp.toc_clear()
    dp.toc_on()
    dp.dry_on()
    body()
    dp.dry_off()

    var tocpg = dp.toc_pages()
    // 目录里的页码 = 干跑页码 + 封面页数 + 目录自身页数
    dp.toc_set_off(1 + tocpg)
    println("toc entries = " + to_string(dp.toc_count()) + "  toc pages = " + to_string(tocpg))

    // ---------- 阶段二：正式排版 ----------
    dp.reset_doc()
    dp.toc_off()
    dp.cover("tie 语言语法规范", "tie Language Specification", "版本 2026.2")
    dp.pagebreak()
    dp.toc_page()
    dp.pagebreak()
    body()

    var ok = dp.end(OUT)
    println("write = " + to_string(ok))

    // ---------- 生成后自检（五层）----------
var vr = dp.verify(OUT)
    if vr == 0 {
        println("verify  = OK (" + to_string(dp.verify_entries()) + " object entries)")
    } else {
        println("verify  = FAILED (code " + to_string(vr) + ")")
        return 1
    }
var obr = dp.verify_objects(OUT)
    if obr == 0 {
        println("objects = OK (" + to_string(dp.verify_objs()) + " objects well-formed)")
    } else {
        println("objects = FAILED (code " + to_string(obr) + ")")
        return 1
    }
var cr = dp.verify_content(OUT)
    if cr == 0 {
        println("content = OK (" + to_string(dp.verify_gids()) + " glyphs used, notdef " + to_string(dp.verify_notdef()) + ")")
    } else {
        println("content = FAILED (code " + to_string(cr) + ")")
        return 1
    }
var lr = dp.verify_layout(595, 842)
    if lr == 0 {
        println("layout  = OK (" + to_string(dp.verify_segs()) + " text segments in bounds)")
    } else {
        println("layout  = FAILED (code " + to_string(lr) + ")")
        return 1
    }
var orc = dp.verify_outlines()
    if orc == 0 {
        println("outline = OK (" + to_string(dp.verify_checked()) + " glyphs checked, " + to_string(dp.verify_empty()) + " blank)")
    } else {
        println("outline = FAILED (code " + to_string(orc) + ")")
        return 1
    }
    println("fonts   = " + to_string(dp.font_count()) + " (0.body " + to_string(dp.used_count(0)) +
        " glyphs, 1.mono " + to_string(dp.used_count(1)) + " glyphs)")
    return 0
}
