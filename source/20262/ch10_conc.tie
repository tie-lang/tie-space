type tie<logic>
// ch10_conc.tie —— 规范正文 · 第 10 章 并发
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch10 {

pub func chapter() {
    dp.h1("第 10 章  并发")

    dp.p("并发在 tie 里由两类构造承担：actor 提供隔离的状态单元，任务图提供带依赖的并行调度。两者的共同前提是「默认不共享可变状态」——共享是通过显式通道或消息传递发生的，不是通过共享内存偶然发生的。")

    // ---------------- 10.1 ----------------
    dp.h2("10.1  并发的基本立场")
    dp.p("数据竞争通常来自两处：两个执行流访问同一块可写内存；或者一处持有指向另一处栈帧的引用。语言在设计上分别封堵：")
    dp.bullet(["共享可变状态通过消息传递表达，通道有明确的所有权归属", "可写借用不能被闭包捕获，因此不会随函数值逃逸到别的执行流", "跨线程传递的值按值复制，不建立隐式别名"])

    // ---------------- 10.2 ----------------
    dp.h2("10.2  状态单元")
    dp.p("actor 是并发的基本单位：它拥有自己的状态，只通过消息与外界交互。对它的状态的访问全部发生在它自己的执行流里，因此不需要锁。")
    dp.codeblock(dp.src(["actor Counter " + lb() + "", "    var n: i64 = 0", "", "    func inc(step: i64) " + lb() + "", "        n += step", "    " + rb() + "", "", "    func value() -> i64 " + lb() + "", "        return n", "    " + rb() + "", "" + rb() + "", "", "var c = Counter()", "c.inc(5)", "println(to_string(c.value()))"]))
    dp.p("调用 actor 方法即发送消息。消息在队列中排队，按到达顺序处理，因此状态变化的顺序是可预期的。")

    // ---------------- 10.3 ----------------
    dp.h2("10.3  消息与返回")
    dp.p("消息可以携带数据。需要结果时，调用等待回复并把结果作为表达式的值。带返回值的调用与普通调用写法相同，等待是隐式的。")
    dp.codeblock(dp.src(["var total = c.value()"]))
    dp.p("发送方与接收方之间传递的数据按值语义复制或转移，因此不存在双方同时持有同一块可写内存的情形。")

    // ---------------- 10.4 ----------------
    dp.h2("10.4  任务与依赖")
    dp.p("当工作之间存在依赖关系时，用任务图描述：节点是工作单元，边是依赖。调度器按依赖顺序推进，互不依赖的节点并行执行。")
    dp.codeblock(dp.src(["var g = graph()", "var a = g.add(fetch_a)", "var b = g.add(fetch_b)", "var c = g.add(merge, a, b)      // c 依赖 a 与 b", "g.run()"]))
    dp.p("任务图中传递的值遵循与 actor 相同的规则：跨节点传递即复制或转移。这使并行部分与串行部分可以自由混合，而不必为边界处的数据归属单独设计。")

    dp.note("并发构造的选择依据是「状态是否需要长期存在」。需要长期存在并被多方交互的状态放在 actor 里；一次性的并行计算用任务图。")

    // ---------------- 10.5 ----------------
    dp.h2("10.5  与闭包捕获的关系")
    dp.p("第 5 章的捕获面白名单在这里体现为一条直接的安全保证：由于可写借用不可被闭包捕获，任何函数值都不持有对他人栈帧的可写引用。把函数值交给别的执行流时，不可能带入一个可写别名。")
    dp.p("这条规则解释了为什么跨线程传递闭包大体是安全的：闭包携带的标量、结构与枚举都是创建时刻的值快照，每个执行流拿到各自独立的副本。唯一的例外通道是容器捕获（见 5.10）——表与映射按引用捕获，多个执行流因此共享同一份底层数据。把携带容器的闭包交给其他执行流时，并发写入由书写者负责排除；需要共享状态时，把状态收敛到状态单元（见 10.2），让访问经由消息串行化，而不是让多个执行流直接触碰同一个表。")
    // ---------------- 10.6 ----------------
    dp.h2("10.6  建立与调用")
    dp.p("建立一个执行体用 run。它取其构造，返回一个句柄；句柄可以复制，多个副本指向同一个执行体，就像同一个地址的多个引用。")
    dp.codeblock(dp.src([r"actor Counter {", r"    var n: i64 = 0", r"", r"    pub func inc(step: i64) -> i64 {", r"        n += step", r"        return n", r"    }", r"", r"    pub async func reset() {", r"        n = 0", r"    }", r"}", r"", r"var c = run Counter()      // 建立，取得句柄", r"var v = c.inc(5)           // 同步调用：等结果", r"c.reset()                  // 异步投递：不等"]))
    dp.p("方法默认是同步的：调用方等待被调方处理完并取回结果。标注为异步的方法则是投递即返回——调用方不等，被调方按到达顺序处理。何时需要等结果、何时只需告知，由方法签名直接表达，不由调用点决定。")
    dp.h3("结果的延后取得")
    dp.p("异步方法也可以带回结果，此时调用得到一个代表将来会有值的凭据，需要取值时再等待。等待点上若被调方出错，错误在等待处抛出——错误与结果走同一条路径，不必单独设计上报通道。")
    dp.codeblock(dp.src([r"var f = worker.compute(input)   // 异步：立即返回凭据", r"// ... 其间可做别的事", r"var r = await f                  // 需要时取值，可能在此抛出被调方的错误"]))
    dp.p("不需要结果时直接丢弃该凭据即可，行为等同于投递。这使得要不要结果不影响书写形态，只影响是否等待。")
    // ---------------- 10.7 ----------------
    dp.h2("10.7  重入")
    dp.p("执行体默认按消息逐条处理，一条处理完才取下一条。当某条处理需要等待另一个执行体的回信时，这段等待会挡住队列。若这种相互等待成环，双方就会互锁。")
    dp.p("把这类方法标注为重入，表示它在等待期间允许队列继续处理其他消息，从而打破环路。代价是等待期间自身状态可能被改变，因此标注重入需要确认方法内部对状态变化的假设仍成立。")
    dp.codeblock(dp.src([r"actor Router {", r"    pub reentrant func route(id: i64) -> i64 {", r"        return downstream.lookup(id)   // 等待期间可继续处理其他消息", r"    }", r"}"]))
    // ---------------- 10.8 ----------------
    dp.h2("10.8  字段初值")
    dp.p("执行体的状态字段在声明处给出初值，且初值必须是字面量——数字、布尔、字符、字符串或空表。语言不提供构造方法。")
    dp.codeblock(dp.src([r"actor Cache {", r"    var hits: i64 = 0", r"    var name: string = """"", r"    var items: table<i64> = []", r"}"]))
    dp.p("限制初值为字面量，是为了让状态在建立那一刻就是确定的：外部读不到半构造状态，也不需要为构造顺序设计规则。需要更复杂初始化的情形，用一个显式的初始化消息完成，那次调用与普通消息走同一路径。")
    // ---------------- 10.9 ----------------
    dp.h2("10.9  数据流图")
    dp.p("需要表达若干工作单元与其依赖关系时，用图。图值与它描述的拓扑同构：花括号界定节点，箭头表示前后依赖，并列表示并行分叉，波浪号前缀表示回边。")
    dp.codeblock(dp.src([r"// 图字面量：并行两路，之后汇合，并带一条回边", r"var flow = { A } - { B } -> { C -> ~ A }", r"", r"// 表形态：节点与边逐条登记", r"var g = graph()", r"var a = g.add(fetch)", r"var b = g.add(parse, a)", r"var c = g.add(store, b)", r"var d = g.add(report, b)", r"g.run()                     // 按依赖顺序推进；无依赖者并行"]))
    dp.p("图本身是值：可以组合、可以传递、可以作为函数值求值。组合产生新图而不修改原图，因此一张图可以在多处安全复用。把值送入图即触发执行，与管道写法一致。")
    dp.h3("检查与查询")
    dp.p("图提供一组查询操作，用于在构造后检查结构：节点与边的枚举、连通性、可达性、环路检测、拓扑序、最短路径、关键路径、最大流与最小割。三态标记可以随图传播，用于在图上表达「是、未知、否」的判定。这些是图值的一等能力，不必自行实现。")

}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
