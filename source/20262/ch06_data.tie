type tie<logic>
// ch06_data.tie —— 规范正文 · 第 6 章 数据结构
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch06 {

pub func chapter() {
    dp.h1("第 6 章  数据结构")

    dp.p("tie 在结构设计上采取一条明确的分离原则：结构只描述数据，逻辑写在命名空间函数里，二者通过名称绑定。这条原则使「这是一个什么东西」与「可以对它做什么」成为两件独立的事，各自可以单独演进。")

    // ---------------- 6.1 ----------------
    dp.h2("6.1  结构的定义")
    dp.p("结构由字段组成，字段有类型与可选的默认值。结构是纯数据——不包含方法、不包含虚表、不引入隐式状态。")
    dp.codeblock(dp.src(["struct Point {", "    var x: f64 = 0.0", "    var y: f64 = 0.0", "    var label: string = \"\"", "}"]))
    dp.p("字段的默认值使得构造可以只给出关心的部分，其余取默认。")

    // ---------------- 6.2 ----------------
    dp.h2("6.2  构造与字段访问")
    dp.p("构造按字段顺序给出实参。字段访问用点号。")
    dp.codeblock(dp.src(["var p = Point(1.0, 2.0)", "p.x = 3.0", "println(p.label)"]))
    dp.p("结构作为参数时默认按值传递；对较大的结构使用只读借用以避免复制，需要修改时使用可写借用。")

    // ---------------- 6.3 ----------------
    dp.h2("6.3  逻辑与数据分离")
    dp.p("结构的行为写在同名命名空间内。命名空间函数的第一个参数是接收者。")
    dp.codeblock(dp.src(["namespace Point {", "    pub func dist(p: Point) -> f64 {", "        return sqrt(p.x * p.x + p.y * p.y)", "    }", "", "    pub func move_by(ref p: Point, dx: f64, dy: f64) {", "        p.x += dx", "        p.y += dy", "    }", "}"]))
    dp.p("这一组织方式有一个直接好处：结构定义保持稳定，而逻辑可以增补、分组、按需导入。新增一个操作不需要改动结构所在的文件。")

    // ---------------- 6.4 ----------------
    dp.h2("6.4  方法调用")
    dp.p("点号调用是对命名空间函数的转发：编译器把 obj.method(args) 解释为「同名命名空间下的 method，接收者作为第一个参数」。这条规则是普遍的：凡命名空间内首参为某类型的函数，都可以写成该类型值的方法形态——内建类型同样适用。")
    dp.codeblock(dp.src(["var p = Point(3.0, 4.0)", "println(p.dist() -> to_string)", "", "p.move_by(1.0, 1.0)", "", "s.len()              // s.len() 的方法形态", "t.push(v)            // 与 t <- v 等价的显式形态"]))
    dp.p("转发意味着方法的参数规则与普通函数完全一致——默认参数、命名实参、借用与转移约定都可以用在方法上。接收者不参与命名，也不能被默认值补齐：它由调用对象给出。")
    dp.codeblock(dp.src(["struct Counter { var n: i64 = 0; }", "", "namespace Counter {", "    pub func bump(c: Counter, step: i64 = 1) -> i64 {", "        return c.n + step", "    }", "}", "", "c.bump()             // step 取默认", "c.bump(step: 4)      // 命名实参"]))
    dp.p("接收者的传递约定由命名空间函数声明决定：需要修改调用对象时把接收者声明为可写借用。")
    dp.p("自由函数形态与方法形态语义完全相同，可以互相改写。正文示例以方法形态为主——它让「谁在做什么」读起来最直白；自由函数保留两个用途：机器生成代码的稳定形态，以及管道中把函数本身作为值传递的场合。")

    // ---------------- 6.5 ----------------
    dp.h2("6.5  继承")
    dp.p("结构可以继承另一个结构的字段，形成「更具体的类型」。继承只复用字段，不引入方法表——行为仍然由命名空间函数提供。")
    dp.codeblock(dp.src(["struct Shape {", "    var name: string = \"\"", "}", "", "struct Circle extends Shape {", "    var r: f64 = 0.0", "}"]))
    dp.p("子类型可以传给期望父类型的参数，字段按前缀布局，因此转换不需要额外工作。")

    // ---------------- 6.6 ----------------
    dp.h2("6.6  语义限制")
    dp.p("以下限制在编译期检查，它们共同保证结构是纯数据的这一性质。")
    dp.bullet(["结构体内不得定义函数；行为写在同名命名空间内", "字段名在同一结构内唯一", "继承链不得成环", "字段默认值必须是常量表达式", "结构作为参数时不得隐式发生窄化转换"])
    dp.note("这些限制不是风格偏好，而是设计后果：结构不携带行为，就没有虚表、没有构造顺序问题、没有隐式析构。调试时看到一个结构值，就看到了它的全部状态。")

    // ---------------- 6.7 ----------------
    dp.h2("6.7  与元组的关系")
    dp.p("元组适合表达「几个值临时组合」；结构适合表达有名字、会长期存在、有自己行为的概念。判据是命名与复用：需要按名字取用、需要在多处传递，就用结构。")
    dp.codeblock(dp.src(["// 临时组合：用元组", "var (lo, hi) = min_max(xs)", "", "// 长期概念：用结构", "struct Interval " + lb() + "", "    var lo: i64 = 0;", "    var hi: i64 = 0;", "" + rb() + ""]))

    // ---------------- 6.8 ----------------
    dp.h2("6.8  运算约定")
    dp.p("结构可以定义运算符的含义。做法是在同名命名空间里提供约定名称的函数，编译器在遇到相应运算时调用它。这样自定义类型可以像内建类型一样书写，而不必到处写方法调用。")
    var w2 = table_new_i64()
    table_push(w2, 170)
    table_push(w2, 281)
    var h2 = table_new_string()
    table_push(h2, "约定名")
    table_push(h2, "触发的运算")
    var r2: table<table<string>> = []
    table_push(r2, dp.kvrow("add / sub / mul / div", "相应的二元算术"))
    table_push(r2, dp.kvrow("neg", "一元取负"))
    table_push(r2, dp.kvrow("eq / cmp", "相等比较与大小比较"))
    table_push(r2, dp.kvrow("index / index_set", "下标读取与下标赋值"))
    table_push(r2, dp.kvrow("to_string", "转为文本"))
    dp.tbl(h2, r2, w2)
    dp.codeblock(dp.src([r"namespace Vec2 {", r"    pub func add(a: Vec2, b: Vec2) -> Vec2 {", r"        return Vec2(a.x + b.x, a.y + b.y)", r"    }", r"    pub func eq(a: Vec2, b: Vec2) -> bool {", r"        return a.x == b.x && a.y == b.y", r"    }", r"}", r"", r"var v = p + q          // 调用 Vec2::add", r"if p == q { }          // 调用 Vec2::eq"]))
    dp.p("约定名称是一份固定清单，不接受任意名称。约定函数是普通函数，可以单独调用——运算符只是它的另一种写法，不存在只能通过运算符访问的行为。")

    // ---------------- 6.9 ----------------
    dp.h2("6.9  计算属性")
    dp.p("对需要按需计算、不宜存储的值，可以定义一对同名函数作为读写入口：读函数除接收者外无参数，写函数多一个值参数。访问时用普通的字段语法。")
    dp.codeblock(dp.src([r"namespace Circle {", r"    pub func area(c: Circle) -> f64 { return 3.14159 * c.r * c.r }", r"    pub func label(c: Circle) -> string { return ""圆 "" + to_string(c.r) }", r"    pub func label_set(ref c: Circle, v: string) { c.name = v }", r"}", r"", r"var a = c.area        // 读：调用计算"]))
    dp.p("读入口与普通字段访问在调用点写法一致，因此这个值究竟是存下来的还是算出来的属于实现细节，改动它不影响使用方。写入口需要接收者可写借用，因为写入必然修改对象。")

    // ---------------- 6.10 ----------------
    dp.h2("6.10  遍历约定")
    dp.p("要让自定义类型可用于遍历语句，在命名空间里提供两个约定函数：一个判断是否还有元素，一个取出当前元素并前进。有了它们，该类型就能出现在遍历语句中。")
    dp.codeblock(dp.src([r"namespace Ring {", r"    pub func has_next(r: Ring) -> bool { return r.i < r.n }", r"    pub func next(ref r: Ring) -> i64 { r.i += 1; return r.buf[r.i - 1] }", r"}", r"", r"for v in ring { println(to_string(v)) }"]))
    dp.p("约定遍历的行为与内建表一致：遍历中的修改规则、元素顺序、取尽后的判定都遵循同一套语义，因此使用方不必区分遍历的是表还是自定义类型。")

    // ---------------- 6.11 ----------------
    dp.h2("6.11  迭代器适配")
    dp.p("遍历约定之上还有一层适配函数，用于把「逐个取元素」组合成常用的变换。适配函数是自由函数，作用于一切满足遍历约定的类型——内建表与自定义类型同等对待。")
    var w3d = table_new_i64()
    table_push(w3d, 230)
    table_push(w3d, 221)
    var h3d = table_new_string()
    table_push(h3d, "函数")
    table_push(h3d, "语义")
    var r3d: table<table<string>> = []
    table_push(r3d, dp.kvrow("xs.iter_map(f)", "逐元素变换，产出 f(元素)。"))
    table_push(r3d, dp.kvrow("xs.iter_filter(p)", "保留判定为真的元素。"))
    table_push(r3d, dp.kvrow("xs.iter_take(n)", "取前 n 个元素。"))
    table_push(r3d, dp.kvrow("iter_zip(a, b)", "两路并读，产出 (a_i, b_i) 元组，短者取尽即止。"))
    table_push(r3d, dp.kvrow("iter_chain(a, b)", "先后串接两路元素。"))
    dp.tbl(h3d, r3d, w3d)
    dp.codeblock(dp.src(["var top = scores -> iter_map(v -> v * 2) -> iter_filter(v -> v > 0)", "for (name, score) in iter_zip(names, scores) " + lb() + "", "    println(name + \": \" + to_string(score))", "" + rb() + ""]))
    dp.p("适配器是惰性的：组合若干适配器不产生中间表，元素在被遍历到的那一刻才计算并流动。这条约定让「变换链」的成本与手写循环相当，也使适配器可以安全作用于无限序列（如计数源）。需要把结果固化为表时，用 table_from(xs) 收拢。")

}

}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }
