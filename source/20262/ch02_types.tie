type tie<logic>
// ch02_types.tie —— 规范正文 · 第 2 章 类型系统
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch02 {

pub func chapter() {
    dp.h1("第 2 章  类型系统")

    dp.p("tie 是静态类型语言：每个表达式在编译期有确定的类型，类型错误在编译期报告，不进入运行期。类型系统同时承担两件事——描述数据的形状，以及表达访问权限（谁可以写、谁只能读、谁拥有所有权）。后者见第 5 章与第 13 章。")
    dp.p("类型分为若干族：基本类型、复合类型（表、元组、映射）、聚合类型（结构、枚举）、函数与接口类型、以及两种特殊类型（宽类型与动态类型）。")

    // ---------------- 2.1 ----------------
    dp.h2("2.1  基本类型")
    dp.p("基本类型直接对应机器表示，没有隐藏的分配与间接层。")

    var w = table_new_i64()
    table_push(w, 160)
    table_push(w, 291)
    var h = table_new_string()
    table_push(h, "类型")
    table_push(h, "含义")
    var r: table<table<string>> = []
    table_push(r, dp.kvrow("i8 i16 i32 i64", "有符号整数，宽度以位计"))
    table_push(r, dp.kvrow("u8 u16 u32 u64", "无符号整数"))
    table_push(r, dp.kvrow("i128 u128", "128 位整数"))
    table_push(r, dp.kvrow("f32 f64", "浮点数"))
    table_push(r, dp.kvrow("bool", "布尔，取值 true / false"))
    table_push(r, dp.kvrow("trit", "平衡三进制，取值正 / 零 / 负（见 2.2）"))
    table_push(r, dp.kvrow("char", "单个字符，按码点计"))
    table_push(r, dp.kvrow("string", "不可变文本，UTF-8 存储"))
    table_push(r, dp.kvrow("void", "无值，仅作函数返回类型"))
    table_push(r, dp.kvrow("code", "编译期代码片段，无运行期实体（见第 12 章）"))
    dp.tbl(h, r, w)

    dp.p("整数默认类型为 i64，浮点默认类型为 f64。字面量在需要的上下文中会按目标类型调整。")

    // ---------------- 2.2 ----------------
    dp.h2("2.2  平衡三进制 trit")
    dp.p("trit 是一个三值类型，取值正、零、负。它用于三路比较、三值逻辑与平衡三进制数论。与布尔相比，它多了一个「未知」状态，因此比两者择一更贴近真实判定。")
    dp.codeblock(dp.src(["var cmp: trit = compare(a, b)   // 正 表示 a>b，零 表示相等，负 表示 a<b", "if cmp == zero " + lb() + "", "    // 相等分支", "" + rb() + ""]))
    dp.p("三值逻辑的运算规则与布尔一致地推广：与运算取小、或运算取大、非运算取反。混合 trit 与整数的运算按提升规则转为整数，除法与取余对 trit 不开放。")

    // ---------------- 2.3 ----------------
    dp.h2("2.3  宽类型")
    dp.p("宽类型是一组类型的类别名，用于在书写时省略具体宽度，或在多种数值类型间统一处理。它只存在于编译期：变量在参与运算时使用推导出的具体类型。")

    var w2 = table_new_i64()
    table_push(w2, 130)
    table_push(w2, 321)
    var h2k = table_new_string()
    table_push(h2k, "关键词")
    table_push(h2k, "覆盖范围")
    var r2: table<table<string>> = []
    table_push(r2, dp.kvrow("num", "全部数值类型：整数与浮点"))
    table_push(r2, dp.kvrow("text", "文本类型：string 与 char"))
    table_push(r2, dp.kvrow("misc", "其余类型：bool、void、code 等"))
    dp.tbl(h2k, r2, w2)

    dp.codeblock(dp.src(["var a: num = 42        // 推导为 i64", "var b: num = 3.14      // 推导为 f64", "var s: text = \"hi\"     // 推导为 string"]))
    dp.p("宽类型最常见的用途是编写同时接受多种数值宽度的函数，例如统计与格式化工具。")

    // ---------------- 2.4 ----------------
    dp.h2("2.4  表类型")
    dp.p("表是动态长度的同质序列，元素类型写在尖括号内。创建表不需要专门的构造器：字面量即构造，空表写作方括号对。")
    dp.codeblock(dp.src(["var fixed: table<i64> = [1, 2, 3]        // 字面量表", "var dyn: table<i64> = []                 // 空表，元素类型由标注确定", "var grown = [1, 2]                       // 无标注：由字面量推导", "dyn <- 1                                 // 追加", "dyn <- 2 <- 30                           // 追加可链式"]))
    dp.p("空表的元素类型从两处确定：有类型标注时取标注；无标注时取首次追加或比较的元素类型，若无从确定则报编译错。需要显式指明时，泛型构造函数 table_new<T>() 与空字面量等价。")
    dp.p("表可嵌套，形成多维结构。遍历使用 for-in，长度用 len。")
    dp.codeblock(dp.src(["var grid: table<table<i64>> = [[1, 2], [3, 4]]", "for row in grid " + lb() + "", "    for cell in row " + lb() + "", "        println(to_string(cell))", "    " + rb() + "", "" + rb() + ""]))

    // ---------------- 2.5 ----------------
    dp.h2("2.5  映射类型")
    dp.p("映射是以键索引的集合，键与值都有类型。键可以是文本、整数或枚举。空映射写作 [:]，与空表相区分。")
    dp.codeblock(dp.src(["var age: map<i64> = [\"alice\": 3, \"bob\": 5]", "var empty: map<i64> = [:]", "age[\"carol\"] = 7", "if \"alice\" in age " + lb() + "", "    println(age[\"alice\"] -> to_string)", "" + rb() + ""]))
    dp.p("映射的字面量语法与表一致，区别在于元素写成「键: 值」。当键为字符串时，可用点号访问其值，这在表达结构化数据时更易读。")

    // ---------------- 2.6 ----------------
    dp.h2("2.6  元组类型")
    dp.p("元组把若干个类型组合成一个值，位置固定、类型可不同。元组用于返回多个结果，或表达「这几个值一起才有意义」的场合。")
    dp.codeblock(dp.src(["func min_max(xs: table<i64>) -> (lo: i64, hi: i64) " + lb() + "", "    // ...", "    return (1, 9)", "" + rb() + "", "", "var (lo, hi) = min_max([3, 1, 9])"]))
    dp.p("元组可命名分量，命名同时作为文档与解构依据。也可不命名，此时用位置访问。")

    // ---------------- 2.7 ----------------
    dp.h2("2.7  类型标注与推导")
    dp.p("tie 的立场是：类型系统是静态的，标注是可选的。类型错误永远是编译错，不推迟到运行期；用户可自由选择写法--动态语言写法或静态语言写法，省略的标注会在编译期推导出来，推导不出来会报错。省略标注时的手感接近动态语言，安全性与运行期效率不变。")
    dp.codeblock(dp.src(["var n: i64 = 0          // 显式标注", "var m = 0               // 推导为 i64", "var s = \"text\"          // 推导为 string", "var rows: table<Entity> = []   // 容器空字面量：标注给出元素类型"]))
    dp.h3("标注可省略的位置")
    dp.bullet(["局部变量：从初始化表达式推导。", "结构字段：带初值时从初值推导。", "函数返回类型：从函数体推导，等号体与块体均可。", "闭包与短闭包参数：从上下文的函数类型推导。", "模块内（非 pub）函数的参数与返回类型：从定义与调用点联合推导。"])
    dp.h3("必须标注的位置")
    dp.p("pub 声明的函数与结构字段必须写出参数与返回类型。公开边界是契约所在，类型在这里起文档与检查的双重作用；边界之内才是推导的领地。这条划分让库作者在边界处想清楚类型，让使用方与内部实现写得随意。")
    dp.codeblock(dp.src(["pub func clamp(v: i64, lo: i64, hi: i64) -> i64 " + lb() + " ... " + rb() + "", "", "func help(a, b) { return a + b }   // 模块内：参数与返回类型全省略"]))
    dp.p("模块内函数的类型仍然完全确定：推导发生在编译期，每个名字都有精确的静态类型，调用错了同样编译报错。省略标注省的是书写，不是检查。")

    // ---------------- 2.8 ----------------
    dp.h2("2.8  泛型")
    dp.p("泛型让类型与算法解耦。类型参数写在尖括号中，编译期为每个具体类型生成一份实现，因此运行期没有额外开销，也没有虚表跳转。")
    dp.codeblock(dp.src(["func max_of<T>(a: T, b: T) -> T " + lb() + "", "    if a > b " + lb() + " return a " + rb() + "", "    return b", "" + rb() + "", "", "struct Box<T> " + lb() + "", "    var value: T", "" + rb() + ""]))
    dp.p("类型参数可带约束，约束由接口描述（见第 7 章）。约束在编译期检查，不满足即报错。")
    dp.codeblock(dp.src(["func render_all<T: Drawable>(items: table<T>) " + lb() + "", "    for it in items " + lb() + "", "        it.draw(0)", "    " + rb() + "", "" + rb() + ""]))

    // ---------------- 2.9 ----------------
    dp.h2("2.9  枚举")
    dp.p("枚举是标签联合：一个值要么是这个标签、要么是那个标签，并可按标签携带数据。它用于表达「几种情况之一」的数据，比用整数代号更安全——每个分支都被检查。")
    dp.codeblock(dp.src(["enum Shape " + lb() + "", "    Circle(r: f64)", "    Rect(w: f64, h: f64)", "" + rb() + "", "", "func area(s: Shape) -> f64 " + lb() + "", "    switch s " + lb() + "", "        case Shape.Circle(r):", "            return 3.14159 * r * r", "        case Shape.Rect(w, h):", "            return w * h", "    " + rb() + "", "" + rb() + ""]))
    dp.p("枚举也可以做通用型参数，用于表达可能失败或可能缺失的结果，这是第 8 章错误处理的基础。")

    // ---------------- 2.10 ----------------
    dp.h2("2.10  动态类型")
    dp.p("any 表示「任意类型」。它在需要容纳异质数据的场合使用，例如配置表、序列化中间结果。任何值都可以赋给 any，取用时需要显式转换。")
    dp.codeblock(dp.src(["var v: any = 42", "v = \"text\"", "if v is i64 " + lb() + "", "    var n = as_i64(v)", "" + rb() + ""]))
    dp.note("静态类型是默认选择。any 把类型错误的发现从编译期推迟到运行期，因此只在确实需要异质容器时使用，而不是作为绕过类型检查的手段。")

    // ---------------- 2.11 ----------------
    dp.h2("2.11  类型转换")
    dp.p("数值类型之间的转换是显式的。窄化转换可能丢失信息，语言要求书写者明确表达意图。")
    dp.codeblock(dp.src(["var a: i64 = 1000", "var b = to_i32(a)        // 窄化：显式", "var c: f64 = to_f64(a)   // 整数到浮点", "var d = to_string(a)     // 到文本"]))
    dp.p("指针与整数之间的转换只在 unsafe 上下文中允许（见第 11 章）。聚合类型与动态类型之间的转换由各自的构造与匹配机制承担。")
    dp.p("转换函数按三族命名，职责不重叠：to_ 系做数值转换与任意值转文本，tp_ 系做可预期的文本解析，as_ 系从动态类型解包。")
    var w3c = table_new_i64()
    table_push(w3c, 190)
    table_push(w3c, 261)
    var h3c = table_new_string()
    table_push(h3c, "函数族")
    table_push(h3c, "语义")
    var r3c: table<table<string>> = []
    table_push(r3c, dp.kvrow("to_i8 … to_u128 / to_f32 / to_f64", "数值类型之间的转换；窄化必须显式写出。"))
    table_push(r3c, dp.kvrow("to_string(v)", "任意值转文本。"))
    table_push(r3c, dp.kvrow("to_i64(s) / to_f64(s)", "文本解析为数值；解析失败触发内建检查，适用于「解析不了就是程序错误」的场合。"))
    table_push(r3c, dp.kvrow("tp_i64(s) / tp_f64(s)", "解析为 Result<i64, string> / Result<f64, string>；失败可预期，由调用方分支处理。"))
    table_push(r3c, dp.kvrow("as_i64 / as_f64 / as_string / as_bool", "从 any 解包；实际类型不符即报错。"))
    dp.tbl(h3c, r3c, w3c)
    dp.codeblock(dp.src(["var n = to_i64(\"4096\")         // 文本解析，失败即内建检查", "var r = tp_i64(s)              // 可预期失败：Result<i64, string>", "var m = as_f64(boxed)          // 从 any 解包"]))

    // ---------------- 2.12 ----------------
    dp.h2("2.12  低层与特殊类型")
    dp.p("以下几类类型用于系统编程、并发与资源管理，它们多数只在不安全上下文或特定场景中出现。")
    var w4 = table_new_i64()
    table_push(w4, 150)
    table_push(w4, 301)
    var h4 = table_new_string()
    table_push(h4, "类型")
    table_push(h4, "说明")
    var r4: table<table<string>> = []
    table_push(r4, dp.kvrow("ptr<T>", "裸指针。指向 T 的地址，可参与算术与解引用，只在不安全上下文中可用。"))
    table_push(r4, dp.kvrow("slice<T>", "切片。指向一段连续元素视图，共享底层数据而不复制。"))
    table_push(r4, dp.kvrow("atomic<T>", "原子类型。提供原子读写与比较交换，用于跨执行流的无锁同步。"))
    table_push(r4, dp.kvrow("guard<域>", "凭据。只能转移、不能复制的许可票据，域取值见第 11 章。"))
    table_push(r4, dp.kvrow("array<T, N>", "定长数组。长度是类型的一部分，在编译期已知。"))
    table_push(r4, dp.kvrow("fn(A, B) -> R", "函数类型。可作为参数、返回值、字段与容器元素。"))
    dp.tbl(h4, r4, w4)

    // ---------------- 2.13 ----------------
    dp.h2("2.13  定长数组")
    dp.p("定长数组的长度写在类型里，因此长度不同的数组是不同类型。它适合表达固定规模的数据——向量、矩阵行、环形缓冲。")
    dp.codeblock(dp.src(["var v: array<f64, 3> = array_init(0.0)", "var m: array<array<f64, 3>, 3> = array_init(v)"]))
    dp.p("长度可以是整数字面量，也可以是常量名或泛型值参数。长度参与类型检查，因此当下标为常量时，越界在编译期即可发现。")

    // ---------------- 2.14 ----------------
    dp.h2("2.14  函数类型")
    dp.p("函数类型用箭头书写，与函数定义的返回位写法一致。任何函数值都有确定的函数类型，包括具名函数、闭包与短闭包。")
    dp.codeblock(dp.src(["var cb: fn(i64) -> i64 = double", "var hook: fn(string) -> void", "func apply(g: fn(i64) -> i64, v: i64) -> i64 " + lb() + " return g(v) " + rb() + ""]))
    dp.p("返回类型可省略——从函数体推导（见 2.7）；pub 声明必须显式写出。无返回值的函数写 void。函数类型可以嵌套，返回函数的函数写作 fn(A) -> fn(B) -> R。")

    // ---------------- 2.15 ----------------
    dp.h2("2.15  行池")
    dp.p("当表的元素是结构时，同一种写法具有另一种语义：它成为按标识符索引的行池。行池的每行有稳定标识，行可以稀疏存在，读取未写过的行得到默认值。")
    dp.codeblock(dp.src(["var rows: table<Entity> = []", "rows[id] = e            // 写入该标识的行", "var r = rows[id]        // 读取；未写过的行得到默认值", "len(rows)               // 最大已写标识加一"]))
    dp.p("行池的价值在于按标识直接定位：不必在表中线性查找，也不必维持标识与下标的一致。它在界面的列表、场景的实体、表格的稀疏数据等处反复出现。行遵循值语义——读出的是副本，写回需要显式赋值。")

    // ---------------- 2.16 ----------------
    dp.h2("2.16  精确数值类型")
    dp.p("浮点无法精确表示十进制小数，这在账目、计量与规格表示中不可接受。语言提供两个精确数值类型：十进制与任意精度整数。")
    var w5 = table_new_i64()
    table_push(w5, 130)
    table_push(w5, 321)
    var h5 = table_new_string()
    table_push(h5, "类型")
    table_push(h5, "语义")
    var r5: table<table<string>> = []
    table_push(r5, dp.kvrow("十进制", "以 符号、系数、十的幂 三元表示。加减乘恒精确；除法与开方在能精确时精确，否则按显式给定的精度与舍入方式处理。无负零、无无穷、无非数。"))
    table_push(r5, dp.kvrow("大整数", "任意精度整数。用于超出机器字长的计数、密码学与数论计算；进制转换覆盖二至四十八进制。"))
    dp.tbl(h5, r5, w5)
    dp.codeblock(dp.src(["var price = 0.1d + 0.2d        // 精确等于 0.3，而非 0.30000000000000004", "var big = big_parse(\"123456789012345678901234567890\")", "var q = div_ctx(a, b, 10, half_even)   // 除法显式给定精度与舍入"]))
    dp.p("零偏差是这两个类型契约的核心：凡是数学上精确的结果，实现就必须精确给出，不允许以「足够接近」代替。舍入只发生在显式要求舍入的调用中，不存在隐式舍入与全局设置。")

    // ---------------- 2.17 ----------------
    dp.h2("2.17  类型别名")
    dp.p("别名给类型起第二个名字，语义上与原类型完全相同——它不是新类型，不产生任何转换边界。别名用于压缩冗长类型、给领域概念以恰当名称。")
    dp.codeblock(dp.src(["alias Matrix = table<f64>", "alias Pair<T> = (T, T)", "alias Handler = fn(Request) -> Response"]))
    dp.p("诊断信息会同时给出原名与别名，因此别名不会让错误信息显得陌生。")

    // ---------------- 2.18 ----------------
    dp.h2("2.18  泛型的值参数")
    dp.p("类型参数之外，泛型还可以接受值参数：在编译期确定的整数或类型。它用于表达规模、容量、精度这类应当是类型一部分的量。")
    dp.codeblock(dp.src(["func zeros<N: i64>() -> array<f64, N> " + lb() + " return array_init(0.0) " + rb() + "", "struct Buffer<CAP: i64 = 1280> " + lb() + " var data: array<u8, CAP> " + rb() + "", "var b = Buffer<512>()          // 容量成为类型的一部分"]))
    dp.p("值参数有默认值时可以省略。把规模放进类型的好处是：规模不匹配在编译期即报错，而不是在运行期越界。")

    // ---------------- 2.19 ----------------
    dp.h2("2.19  字符串处理")
    dp.p("字符串的内建操作以 str_ 前缀的自由函数提供，与 str_len、str_char 同族。全部操作以码点为尺度（见 1.3），不按字节切碎文本。")
    var w5c = table_new_i64()
    table_push(w5c, 230)
    table_push(w5c, 221)
    var h5c = table_new_string()
    table_push(h5c, "函数")
    table_push(h5c, "语义")
    var r5c: table<table<string>> = []
    table_push(r5c, dp.kvrow("s.split(sep)", "按分隔符拆分为表<string>；分隔符不保留。"))
    table_push(r5c, dp.kvrow("parts.join(sep)", "以分隔符拼接表<string>。"))
    table_push(r5c, dp.kvrow("s.contains(sub)", "是否包含子串。"))
    table_push(r5c, dp.kvrow("s.starts(pre) / s.ends(suf)", "前缀与后缀判定。"))
    table_push(r5c, dp.kvrow("s.replace(old, new)", "替换全部出现的子串。"))
    table_push(r5c, dp.kvrow("s.trim()", "去除首尾空白。"))
    table_push(r5c, dp.kvrow("s.reverse()", "按码点逆置。"))
    table_push(r5c, dp.kvrow("s.upper() / s.lower()", "大小写转换（仅 ASCII 字母，其余原样）。"))
    dp.tbl(h5c, r5c, w5c)
    dp.codeblock(dp.src(["var fields = \"a,b,c\".split(\",\")     // [\"a\", \"b\", \"c\"]", "var line = fields.join(\" | \")        // \"a | b | c\"", "if name.starts(\"test_\") " + lb() + " " + rb() + ""]))
    dp.note("需要把数值拼进文本时，优先用插值字符串与格式说明符（见 1.9）；str_ 系承担的是结构化文本操作——拆分、拼接、查找、修剪——而非格式化。")

    // ---------------- 2.20 ----------------
    dp.h2("2.20  集合操作")
    dp.p("表与映射的内建操作同样是自由函数。原地生效的操作返回自身，因此可以直接接入管道；产出新值的操作不改原表。")
    var w6c = table_new_i64()
    table_push(w6c, 230)
    table_push(w6c, 221)
    var h6c = table_new_string()
    table_push(h6c, "函数")
    table_push(h6c, "语义")
    var r6c: table<table<string>> = []
    table_push(r6c, dp.kvrow("t.sort()", "升序排序，元素需可比较；原地生效并返回自身。"))
    table_push(r6c, dp.kvrow("t.sort_by(cmp)", "以比较函数排序；原地生效并返回自身。"))
    table_push(r6c, dp.kvrow("t.reverse()", "逆置；原地生效并返回自身。"))
    table_push(r6c, dp.kvrow("t.distinct()", "保序去重，返回新表。"))
    table_push(r6c, dp.kvrow("a.concat(b)", "拼接两表，返回新表。"))
    table_push(r6c, dp.kvrow("t.group_by(key)", "按键函数分组，返回 map<table<T>>。"))
    dp.tbl(h6c, r6c, w6c)
    dp.codeblock(dp.src(["var top = scores -> sort() -> reverse() -> iter_take(10)", "var rows = orders.group_by(o -> o.city)"]))
    dp.p("排序是稳定的：相等元素的相对次序在排序后保持不变。这让多重排序可以先按次关键字排序、再按主关键字排序地组合出来。")

}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
