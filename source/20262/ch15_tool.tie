type tie<logic>
// ch15_tool.tie —— 规范正文 · 第 15 章 工具链与语言服务
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch15 {

pub func chapter() {
    dp.h1("第 15 章  工具链与语言服务")

    dp.p("语言规范定义了什么是对的；工具链让书写、检查与维护这件事变得可行。本章说明编译、诊断、格式化与文档生成的行为约定。")

    // ---------------- 15.1 ----------------
    dp.h2("15.1  编译流程")
    dp.p("编译分为若干阶段，每阶段有明确的输入输出，可以对中间产物单独检查。")

    var w = table_new_i64()
    table_push(w, 130)
    table_push(w, 321)
    var h = table_new_string()
    table_push(h, "阶段")
    table_push(h, "职责")
    var r: table<table<string>> = []
    table_push(r, dp.kvrow("预处理", "处理头部声明、导入关系与编译期开关"))
    table_push(r, dp.kvrow("词法与语法", "切分记号、构建语法结构，报告语法错误"))
    table_push(r, dp.kvrow("语义分析", "类型检查、约定检查、所有权与移动检查、捕获面检查"))
    table_push(r, dp.kvrow("中间表示", "下沉为与机器无关的中间代码"))
    table_push(r, dp.kvrow("优化", "常量折叠、内联、单态化展开、无用代码消除"))
    table_push(r, dp.kvrow("生成", "产出目标代码并与运行时链接"))
    dp.tbl(h, r, w)

    dp.p("语义分析阶段的检查顺序是确定的：类型在前，约定居中，所有权与捕获在后。固定的顺序使得同一次编译里的报错不会因为检查次序而变化。")

    // ---------------- 15.2 ----------------
    dp.h2("15.2  命令行")
    dp.p("编译器的常用调用形态是一致而可组合的：源文件、输出、开关。")
    dp.codeblock(dp.src(["tiec app.tie                    // 编译为可执行文件", "tiec lib.tie -o lib.a           // 编译为静态库", "tiec app.tie --emit-ir          // 只产出中间表示", "tiec app.tie --check            // 只做检查，不产物", "tiec app.tie --emit-pdf         // 随产物输出结构报告"]))
    dp.p("优化级别与目标平台属于命令行开关，不写在源文件里。这样同一份源码可以在不同目标下编译，而不必为每个目标维护一份文件。")

    // ---------------- 15.3 ----------------
    dp.h2("15.3  诊断信息")
    dp.p("每条诊断有稳定的编号、明确的类别与指向具体位置的坐标。编号使得错误可以被引用、被加入回归语料，而不必复述整段消息。")
    dp.codeblock(dp.src(["error[E00387] main.tie:12:5: 命名实参调用 'connect' 缺少第 2 个形参 'port' 的值", "warning[W00008] main.tie:3:5: 变量 'tmp' 未被使用"]))
    dp.p("诊断的撰写遵循三条约定：指出问题所在的位置；说明期望与实际的差别；在能给出修法时给出修法。")

    // ---------------- 15.4 ----------------
    dp.h2("15.4  格式化与静态检查")
    dp.p("格式化工具按统一规则重排代码，使风格差异不进入评审。它的输出是确定的：同一份代码格式化两次结果相同。")
    dp.p("静态检查工具在编译之外给出建议，覆盖可能的疏漏——未使用的变量、被遮蔽的名称、恒真的条件、可以简化成管道表达式的嵌套调用。")
    dp.codeblock(dp.src(["tiefmt src/          // 就地格式化", "tielint src/         // 静态检查"]))

    // ---------------- 15.5 ----------------
    dp.h2("15.5  文档生成")
    dp.p("以三条斜线书写的文档注释被工具提取，与声明一起生成 API 文档。文档注释紧接在声明之前，就属于那个声明；写在函数体内部则退化为普通注释。")
    dp.p("文档注释的第一行是摘要，其余部分与正文使用同一套排版记号，只是写成文本形态。")

    var wdoc = table_new_i64()
    table_push(wdoc, 130)
    table_push(wdoc, 321)
    var hdoc = table_new_string()
    table_push(hdoc, "排版构件")
    table_push(hdoc, "文档注释里的写法")
    var rdoc: table<table<string>> = []
    table_push(rdoc, dp.kvrow("摘要", "首行"))
    table_push(rdoc, dp.kvrow("段落", "空行分隔：一行只有三条斜线"))
    table_push(rdoc, dp.kvrow("代码块", "整行缩进四空格"))
    table_push(rdoc, dp.kvrow("清单", "每项以 - 开头"))
    table_push(rdoc, dp.kvrow("提示", "以 > 开头"))
    table_push(rdoc, dp.kvrow("小标题", "以 # 开头，个数表示层级"))
    dp.tbl(hdoc, rdoc, wdoc)

    dp.codeblock(dp.src(["/// 求两数的最大公约数。", "///", "/// 示例：", "///     gcd(12, 18)   // 6", "///", "/// > 入参为零时返回另一数。", "pub func gcd(a: i64, b: i64) -> i64 " + lb() + " " + rb() + ""]))
    dp.p("参数的说明不重复进文档注释：类型、可空、默认值、ref / immut / move 都是签名的一部分（见 16.13）。文档注释说明签名表达不了的东西——这一项为什么存在、取值范围、边界行为、与谁相关。")

    // ---------------- 15.6 ----------------
    dp.h2("15.6  交互式环境")
    dp.p("交互式环境接受表达式并立即求值，用于试验标准库函数与语言构造。它与编译使用同一套语义实现，因此交互环境里的结果与编译产物的行为一致。")
    dp.codeblock(dp.src(["$ tie", "> var xs = [3, 1, 2]", "> xs -> sort", "[1, 2, 3]"]))

    // ---------------- 15.7 ----------------
    dp.h2("15.7  语言服务")
    dp.p("语言服务为编辑器提供补全、跳转、悬停与实时诊断。它按文件增量重算，不要求整工程重新编译；诊断的编号与命令行输出一致，因此编辑器中的提示与构建日志可以直接对照。")
    dp.note("工具链与语言本身共用同一份实现：解析、类型检查与诊断由同一套代码提供，这保证编辑器里看到的结论与编译结果不会出现分歧。")
}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
