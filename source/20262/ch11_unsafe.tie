type tie<logic>
// ch11_unsafe.tie —— 规范正文 · 第 11 章 不安全机制
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch11 {

pub func chapter() {
    dp.h1("第 11 章  不安全机制")

    dp.p("语言的安全保证建立在「不出现未定义行为」之上。绝大多数代码不需要违反这条前提，因此默认落在安全区内；少数需要直接操作内存、调用外部接口或放宽检查的场合，语言提供一处显式标记：不安全区。")

    // ---------------- 11.1 ----------------
    dp.h2("11.1  安全区的边界")
    dp.p("安全区内不允许出现以下构造——它们在编译期被拒绝，而不是在运行期碰运气。")
    dp.bullet(["指针类型作为变量、参数或字段类型", "对指针的解引用", "指针与整数之间的转换", "调用标记为不安全的函数", "闭包捕获可写借用参数"])
    dp.p("这些限制覆盖了内存不安全的主要来源：悬垂引用、越界访问、类型混淆、数据竞争。")

    // ---------------- 11.2 ----------------
    dp.h2("11.2  不安全区")
    dp.p("不安全区有两种形态：标记为不安全的函数，以及函数体内的不安全块。二者都把「此处由书写者承担内存正确性的责任」写在代码里。")
    dp.codeblock(dp.src(["unsafe " + lb() + "", "    var buf = alloc(16)", "    deref_write(buf, as_u8(1))", "    var v = as_i64(deref(buf))", "    free(buf)", "" + rb() + ""]))
    dp.p("不安全函数在签名上标注 unsafe。安全代码调用不安全函数必须自己处在不安全区内，这一要求由编译器强制：调用链上每一处跨越都必须显式。")

    // ---------------- 11.3 ----------------
    dp.h2("11.3  指针操作")
    dp.p("指针类型在类型名上体现为 ptr 与元素类型。指针的分配、读写、偏移与释放都在不安全区内进行。")
    dp.codeblock(dp.src(["var p = alloc(64)              // 分配", "var q = ptr_add(p, 8)          // 偏移到第 8 字节", "deref_write(q, as_i64(42))     // 写入", "var n = as_i64(deref(q))       // 读出", "var a = ptr_to_int(p)          // 转为整数（传给外部接口）", "free(p)                       // 释放"]))
    dp.p("指针与整数的双向转换使外部接口的调用可以表达：把地址作为整数传给不接受指针类型的接口，或把返回的整数重新解释为指针。")

    // ---------------- 11.4 ----------------
    dp.h2("11.4  放宽的检查")
    dp.p("不安全区内的部分检查放宽，由书写者承担后果。放宽的范围是明确的、有限的：指针相关的检查与借用逃逸的检查。其余检查——类型相容、参数个数、分支完备性——在任何地方都不会关闭，因为它们与内存布局无关。")
    dp.p("闭包捕获可写借用的限制在不安全区内解除，用于需要把借用显式传递到回调的场合。此时借用的有效期由书写者保证。")

    // ---------------- 11.5 ----------------
    dp.h2("11.5  审计友好")
    dp.p("不安全机制的形态经过取舍：它不采用「关闭全文件检查」的开关，也不采用隐式的宽松规则，而是要求把每个不安全操作写在标记区内。这样做的目的是让审计可以按文本搜索完成。")
    dp.bullet(["搜索 unsafe 即可定位全部需要人工复核的位置", "不安全区的边界在语法上可见，不依赖约定", "解引用记号使指针访问在语句层面可辨认"])
    dp.note("封装外部接口时，把不安全操作收敛到少数模块，对外只暴露签名安全、行为可预期的接口。这样不安全区的总量可控，复用这些封装的使用方无需关心内部细节。")
    // ---------------- 11.6 ----------------
    dp.h2("11.6  能力域与凭据")
    dp.p("不安全操作按其触犯的安全前提分组，每组称为一个能力域。要执行某个域内的操作，必须持有该域的凭据。凭据是一类特殊的值：它可以转移，但不能复制——因此同一时刻只有一处持有它，不存在权限被悄悄扩散的情形。")
    var w2 = table_new_i64()
    table_push(w2, 110)
    table_push(w2, 331)
    var h2 = table_new_string()
    table_push(h2, "能力域")
    table_push(h2, "覆盖的不安全操作")
    var r2: table<table<string>> = []
    table_push(r2, dp.kvrow("内存域", "解引用、指针算术、原始分配与释放、取地址。"))
    table_push(r2, dp.kvrow("外部域", "调用外部函数——包括系统调用与第三方库，越过了本语言的类型保证。"))
    table_push(r2, dp.kvrow("共享域", "跨执行流共享可变数据，越过「默认不共享可变状态」的前提。"))
    table_push(r2, dp.kvrow("运行时域", "接入运行时设施，越过运行时的调度与生命周期约定。"))
    table_push(r2, dp.kvrow("裸域", "内联汇编、易失访存、非结构化跳转——直接绕过编译器对代码的假设。"))
    dp.tbl(h2, r2, w2)
    dp.p("取得凭据的方式是显式请求。请求写成一次调用，返回凭据值；此后在一个显式的块内持证操作，块结束时凭据失效。")
    dp.codeblock(dp.src([r"var g = unsafe.get(内存域)         // 请求凭据", r"unsafe use g {                     // 持证块：块内可做该域的操作", r"    var p = alloc(64)", r"    \\p = as_u8(1)", r"}", r"", r"unsafe with(共享域) {              // 作用域临时凭据：退块自动回收", r"    shared_counter += 1", r"}"]))
    dp.p("凭据可以「限制委托」：把凭据收窄到一个具体对象或更小的域后再交出去。也可以绑定到特定对象，表示这份许可只对该对象有效。需要时可以主动撤销，撤销后子女凭据一并失效。")
    dp.codeblock(dp.src([r"var sub = g.delegate()             // 委托一份受限凭据", r"var bound = unsafe.get(内存域 -> buf)   // 绑定到具体对象", r"unsafe.revoke(g)                   // 撤销：此后凭据不可用"]))
    dp.h3("按模块授权")
    dp.p("系统桥接与外部接口封装这类模块通篇都是不安全操作，逐个函数标注会淹没代码。此时在文件头部一次性授权该文件可用的能力域，或在函数与执行体上标注，表示该单元整体持证。")
    dp.codeblock(dp.src([r"type tie<class, unsafe>           // 整个文件处于不安全上下文", r"#[unsafe.共享域]                    // 函数级：该函数隐式持证", r"pub func aggregate() -> i64 { ... }"]))
    dp.p("按模块授权是粗粒度的，因此它的适用范围是「整块代码都属同一域」的场合。审计时这类文件仍然可见——头部或标注本身就是标记，搜索能力域名称即可定位全部授权点。
")
    // ---------------- 11.7 ----------------
    dp.h2("11.7  内联汇编")
    dp.p("需要直接书写机器指令时用内联汇编。操作数以「方向加约束」的形式声明：哪些是输入、哪些是输出、哪些既读又写，以及它们要占用寄存器还是内存。")
    dp.codeblock(dp.src([r"unsafe {", r"    asm!('add {dst}, {src}', dst: 输出(寄存器) = v, src: 输入(寄存器) = n)", r"}", r"", r"// 操作数方向：输出 / 输入 / 既读又写", r"// 约束位置：寄存器 / 内存"]))
    dp.p("这份声明让编译器知道指令读了什么、写了什么，因而能在汇编块周围正确安排寄存器与内存的可见性。把方向和约束写清楚，是内联汇编可被优化而不出错的前提。")
    // ---------------- 11.8 ----------------
    dp.h2("11.8  安全边界的重分类")
    dp.p("安全与不平等的边界不是固定不变的，它随实现能提供的保证而移动。以下几类操作随着实现成熟，从需要持证变为安全代码即可使用。")
    dp.bullet(["原子类型的全部操作（原子读写与比较交换）：此前需内存域，现由类型系统保证其正确使用。", "切片类型与其下标访问：此前需内存域，现由边界检查保证。", "指针类型的声明、比较与传参：此前需内存域，现只需不解引用即安全。", "明确声明内存布局的结构：布局由声明保证，不需持证。"])
    dp.p("仍维持需要持证的是：解引用、指针算术与偏移、原始缓冲分配、取地址、外部函数调用、易失访存、内联汇编、非结构化跳转，以及跨执行流共享可变数据。")
    dp.p("这条边界线的划法是：凡实现能够自行保证其安全的，就归入安全区；凡安全性取决于书写者判断的，就维持持证。这条线只随实现能力移动，不随使用便利移动。
")

}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
