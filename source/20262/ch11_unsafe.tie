type tie<logic>
// ch11_unsafe.tie —— 规范正文 · 第 11 章 不安全机制
import "F:/Projects/tie-repo/tie-spec/source/20262/pdfdoc.tie" as dp

namespace ch11 {

pub func chapter() {
    dp.h1("第 11 章  不安全机制")

    dp.p("语言的安全保证建立在「不出现未定义行为」之上。绝大多数代码不需要违反这条前提，因此默认落在安全区内；少数需要直接操作内存、调用外部接口或放宽检查的场合，语言提供一处显式标记：不安全区。")

    // ---------------- 11.1 ----------------
    dp.h2("11.1  安全区的边界")
    dp.p("安全区内不允许出现以下构造——它们在编译期被拒绝，而不是在运行期碰运气。")
    dp.bullet(["对指针的解引用与写入", "原始缓冲的分配与释放", "内存块的批量拷贝与填充", "易失访存与内联汇编", "调用标记为不安全的函数", "闭包捕获可写借用参数", "非结构化跳转"])
    dp.p("注意两处不在其列。其一，「指针类型」本身不在其列：声明、比较、传递一个指针值不会引发未定义行为。其二，「产出指针值」的操作也不在其列：取地址、指针偏移、指针与整数之间的转换都是纯值运算，不触碰内存，结果即便无效也只在被解引用时才成为问题，而解引用另有门禁。安全与不安全的这条线，画在「是否要求书写者先满足某个安全前提」上（见 11.8）。")
    dp.p("这些限制覆盖了内存不安全的主要来源：悬垂引用、越界访问、类型混淆、数据竞争。")

    // ---------------- 11.2 ----------------
    dp.h2("11.2  不安全区")
    dp.p("不安全区有两种形态：标记为不安全的函数，以及函数体内的不安全块。二者都把「此处由书写者承担内存正确性的责任」写在代码里。")
    dp.codeblock(dp.src(["unsafe " + lb() + "", "    var buf = alloc(16)", "    deref_write(buf, as_u8(1))", "    var v = as_i64(deref(buf))", "    free(buf)", "" + rb() + ""]))
    dp.p("不安全函数在签名上标注 unsafe。安全代码调用不安全函数必须自己处在不安全区内，这一要求由编译器强制：调用链上每一处跨越都必须显式。")

    // ---------------- 11.3 ----------------
    dp.h2("11.3  指针操作")
    dp.p("指针类型在类型名上体现为 ptr 与元素类型。指针的「分配、读写与释放」在不安全区内进行；而「产出指针值」的一应操作——取地址、偏移、与整数互转——不触碰内存，在安全代码中即可使用（见 11.8）。指针值的声明、比较与传递同理。")
    dp.codeblock(dp.src(["var p = alloc(64)              // 分配：须不安全区", "var q = ptr_add(p, 8)          // 偏移到第 8 字节：安全（纯地址计算）", "deref_write(q, as_i64(42))     // 写入：须不安全区", "var n = as_i64(deref(q))       // 读出：须不安全区", "var a = ptr_to_int(p)          // 转为整数：安全（纯转换）", "free(p)                       // 释放：须不安全区"]))
    dp.p("指针与整数的双向转换使外部接口的调用可以表达：把地址作为整数传给不接受指针类型的接口，或把返回的整数重新解释为指针。")

    // ---------------- 11.4 ----------------
    dp.h2("11.4  放宽的检查")
    dp.p("不安全区内的部分检查放宽，由书写者承担后果。放宽的范围是明确的、有限的：指针操作相关的检查与借用逃逸的检查。其余检查——类型相容、参数个数、分支完备性——在任何地方都不会关闭，因为它们与内存布局无关。")
    dp.p("闭包捕获可写借用的限制在不安全区内解除，用于需要把借用显式传递到回调的场合。此时借用的有效期由书写者保证。")

    // ---------------- 11.5 ----------------
    dp.h2("11.5  审计友好")
    dp.p("不安全机制的形态经过取舍：它不采用「关闭全文件检查」的开关，也不采用隐式的宽松规则，而是要求把每个不安全操作写在标记区内。这样做的目的是让审计可以按文本搜索完成。")
    dp.bullet(["搜索 unsafe 即可定位全部需要人工复核的位置", "不安全区的边界在语法上可见，不依赖约定", "解引用记号使指针访问在语句层面可辨认"])
    dp.note("封装外部接口时，把不安全操作收敛到少数模块，对外只暴露签名安全、行为可预期的接口。这样不安全区的总量可控，复用这些封装的使用方无需关心内部细节。")
    // ---------------- 11.6 ----------------
    dp.h2("11.6  能力域与凭据")
    dp.p("不安全操作按其触犯的安全前提分组，每组称为一个能力域。要执行某个域内的操作，必须持有该域的凭据。凭据是一类特殊的值：它可以转移，但不能复制——因此同一时刻只有一处持有它，不存在权限被悄悄扩散的情形。")
    var w2 = table_new_i64()
    table_push(w2, 110)
    table_push(w2, 331)
    var h2 = table_new_string()
    table_push(h2, "能力域")
    table_push(h2, "覆盖的不安全操作")
    var r2: table<table<string>> = []
    table_push(r2, dp.kvrow("mem", "解引用、指针算术、原始分配与释放、取地址。"))
    table_push(r2, dp.kvrow("ext", "调用语言无法核对的外部代码——自行声明的外部函数、交给外部的函数指针、动态装载的代码。系统调用与常用库已由语言封装为安全接口，不需凭据。"))
    table_push(r2, dp.kvrow("share", "跨执行流共享可变数据，越过「默认不共享可变状态」的前提。"))
    table_push(r2, dp.kvrow("raw", "内联汇编、易失访存、非结构化跳转——直接绕过编译器对代码的假设。"))
    table_push(r2, dp.kvrow("lock", "对容器的访问去掉运行时锁——越过「并发访问由运行时看护」的前提，正确性由书写者担责。"))
    dp.tbl(h2, r2, w2)
    dp.p("取得凭据的方式是显式请求。请求写成一次调用，返回凭据值；此后在一个显式的块内持证操作，块结束时凭据失效。")
    dp.codeblock(dp.src([r"var g = unsafe.get(mem)            // 请求凭据", r"unsafe use g {                     // 持证块：块内可做该域的操作", r"    var p = alloc(64)", r"    \\p = as_u8(1)", r"}", r"", r"unsafe with(share) {               // 作用域临时凭据：退块自动回收", r"    shared_counter += 1", r"}", r"", r"unsafe with(lock) {                // 该块内对容器的访问不再取运行时锁", r"    buf[i] = v", r"}"]))
    dp.p("凭据可以派生：把域名再写一次，得到一份新的凭据，原凭据随之交出（此后不再可用）。也可以绑定到特定对象，表示这份许可只对该对象有效。")
    dp.codeblock(dp.src([r"var sub = g.delegate(mem)          // 派生新凭据（同域）；原凭据交出", r"var bound = unsafe.get(mem -> buf)  // 绑定到具体对象", r"unsafe.revoke(g)                   // 撤销：此后凭据不可用"]))
    dp.p("撤销作用于凭据本身。撤销一份凭据后，由它（传递）派生出的凭据一并失效，再使用它们会被拒绝；撤销不因凭据已被派生交出而失去对象——一份凭据即便已经通过 delegate 交出去，仍可撤销它，从而收回其下游的全部许可。重复撤销同一凭据、或撤销根本不是凭据的值，都会被拒绝。")
    dp.h3("按模块授权")
    dp.p("系统桥接与外部接口封装这类模块通篇都是不安全操作，逐个函数标注会淹没代码。此时在文件头部一次性授权该文件可用的能力域，或在函数与执行体上标注，表示该单元整体持证。")
    dp.codeblock(dp.src([r"type tie<class, unsafe>            // 整个文件处于不安全上下文", r"type tie<class, unsafe:lock>       // 并授权 lock 域：本文件各函数隐式持该证", r"#[unsafe.share]                     // 函数级：该函数隐式持证（域写在标注里）", r"pub func aggregate() -> i64 { ... }"]))
    dp.p("文件级授权只作用于这个文件：它被别的文件引入时，授权不会随之扩散过去。")
    dp.p("按模块授权是粗粒度的，因此它的适用范围是「整块代码都属同一域」的场合。审计时这类文件仍然可见——头部或标注本身就是标记，搜索能力域名称即可定位全部授权点。
")
    // ---------------- 11.7 ----------------
    dp.h2("11.7  内联汇编")
    dp.p("需要直接书写机器指令时用内联汇编。操作数以「方向加约束」的形式声明：哪些是输入、哪些是输出、哪些既读又写，以及它们要占用寄存器还是内存。")
    dp.codeblock(dp.src([r"unsafe {", r"    asm!('add {dst}, {src}', dst: 输出(寄存器) = v, src: 输入(寄存器) = n)", r"}", r"", r"// 操作数方向：输出 / 输入 / 既读又写", r"// 约束位置：寄存器 / 内存"]))
    dp.p("这份声明让编译器知道指令读了什么、写了什么，因而能在汇编块周围正确安排寄存器与内存的可见性。把方向和约束写清楚，是内联汇编可被优化而不出错的前提。")
    // ---------------- 11.8 ----------------
    dp.h2("11.8  安全边界的重分类")
    dp.p("安全与不平等的边界不是固定不变的，它随实现能提供的保证而移动。以下几类操作随着实现成熟，从需要持证变为安全代码即可使用；下列重分类均已生效。")
    dp.bullet(["原子类型的全部操作（原子读写与比较交换）：此前需 mem 域，现由类型系统保证其正确使用。", "切片类型与其视图、长度与下标访问：此前需 mem 域，现由边界检查保证——越界是可捕获的失败，不是未定义行为。", "指针类型的声明、比较、传参与返回：此前需 mem 域，现只需不解引用即安全。", "产出指针值的一应操作——取地址、取字段地址、指针偏移、指针与整数互转：此前需 mem 域，现为纯值运算，不触碰内存。", "明确声明内存布局的结构：布局由声明保证，不需持证。"])
    dp.p("这组重分类的共同点是把边界从「类型」移到「操作」：说得出「一个指针」不等于能对它做危险的事，所以类型本身不再需要持证，而危险操作照旧需要。")
    dp.p("顺着这条线再推一步，边界可以收得更准：「一个操作需要持证，当且仅当它要求书写者先满足某个安全前提」——这个前提可以是「指针有效」，也可以是「内存已初始化、未重复释放、长度不越界」。产出指针值的一应操作没有这样的前提，因而全部归入安全区；而解引用、分配与释放、块拷贝、易失访存各有前提，一律维持持证。")
    dp.p("仍维持需要持证的是：对指针的解引用与写入、原始缓冲的分配与释放、内存块的批量拷贝与填充、易失访存、内联汇编、非结构化跳转、调用语言无法核对的外部代码、跨执行流共享可变数据，以及对容器访问去掉运行时锁。")
    dp.p("这条边界线的划法是：凡实现能够自行保证其安全的，就归入安全区；凡安全性取决于书写者判断的，就维持持证。这条线只随实现能力移动，不随使用便利移动。
")

}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
