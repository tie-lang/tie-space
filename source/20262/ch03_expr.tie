type tie<logic>
// ch03_expr.tie —— 规范正文 · 第 3 章 运算符与表达式
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch03 {

pub func chapter() {
    dp.h1("第 3 章  运算符与表达式")

    dp.p("表达式由运算符与操作数构成。本章按优先级自高到低说明各运算符的形态与语义，并单列 tie 特有的若干记号——它们的共同目标是让常见意图有专有的书写形式，而不是靠函数调用或状态变量绕行。")

    // ---------------- 3.1 ----------------
    dp.h2("3.1  优先级与结合性")
    dp.p("优先级自高到低如下表。同一行的运算符优先级相同，按结合性方向结合。括号可覆盖默认优先级。")
    var w = table_new_i64()
    table_push(w, 50)
    table_push(w, 220)
    table_push(w, 181)
    var h = table_new_string()
    table_push(h, "级")
    table_push(h, "运算符")
    table_push(h, "结合性")
    var r: table<table<string>> = []
    table_push(r, three("1", "后缀 [ ] . :: ( ) ?. ?[", "左"))
    table_push(r, three("2", "一元 - ! ~ ++ -- \\", "右"))
    table_push(r, three("3", "**  **?", "右"))
    table_push(r, three("4", "*  /  %  \\  %%  *?", "左"))
    table_push(r, three("5", "+  -  +?  -?", "左"))
    table_push(r, three("6", "<<  >>", "左"))
    table_push(r, three("7", "<  >  <=  >=（可链式）", "左"))
    table_push(r, three("8", "in  not in", "左"))
    table_push(r, three("9", "==  !=", "左"))
    table_push(r, three("10", "&", "左"))
    table_push(r, three("11", "^", "左"))
    table_push(r, three("12", "|", "左"))
    table_push(r, three("13", "&&", "左"))
    table_push(r, three("14", "||", "左"))
    table_push(r, three("15", "?: 条件默认", "右"))
    table_push(r, three("16", "->  <-（数据流）", "左"))
    table_push(r, three("17", "with 不可变更新", "左"))
    table_push(r, three("18", ".. ..= 区间", "—"))
    dp.tbl(h, r, w)

    dp.note("两条容易记错的相对关系：幂高于乘除，且优先与左侧一元运算结合（故 -2 ** 2 等于 4）；成员判定比相等比较更紧（故 x in xs == false 等于 (x in xs) == false）。")

    // ---------------- 3.2 ----------------
    dp.h2("3.2  算术运算")
    dp.p("算术运算符对整数与浮点生效，规则与通常预期一致。整数除零在运行期报错，语言不做静默截断。")
    dp.codeblock(dp.src(["var a = 7 + 3      // 10", "var b = 7 / 3      // 2     整数除法截断", "var c = 7.0 / 3.0  // 2.333 浮点除法", "var d = 7 % 3      // 1     取余"]))
    dp.p("整数运算在溢出时按位宽回绕。需要检出溢出时使用带检查的形式（见 3.5）。")

    // ---------------- 3.3 ----------------
    dp.h2("3.3  整除与成对取余")
    dp.p("整除与取余是一对记号：整除给出向下取整的商，取余给出与之配对的余数。二者成对使用，保证商与余数自洽——即 商乘除数加余数恒等于被除数。这是普通乘除取余在负数上无法满足的性质。")
    dp.codeblock(dp.src(["var q = 7 \\ 3      // 2     整除（向下取整）", "var m = 7 %% 3     // 1     成对取余", "q = -7 \\ 3         // -3", "m = -7 %% 3        // 2     自洽：-3 * 3 + 2 == -7", "q \\= 2             // 整除复合赋值"]))
    dp.note("整除曾用两个斜杠书写，因与行注释冲突而改为反斜杠。反斜杠同时用于解引用（见 3.14），但两者位置不同：作二元运算符时是整除，作一元前缀时是解引用。")

    // ---------------- 3.4 ----------------
    dp.h2("3.4  幂运算")
    dp.p("幂运算写作两个星号，右结合，因此连续幂按从右往左分组。")
    dp.codeblock(dp.src(["var p = 2 ** 10        // 1024", "var q = 2 ** 3 ** 2     // 512   右结合，即 2 ** (3 ** 2)"]))
    dp.p("带检查的幂写作 **?，在结果超出该类型表示范围时报告错误，而不是回绕。数值敏感的计算应使用这一形式。")

    // ---------------- 3.5 ----------------
    dp.h2("3.5  带检查的运算")
    dp.p("加、减、乘、幂与移位各有一个带检查的变体，运算符后接问号。溢出或越界时不再回绕，而是触发可捕获的错误。")
    dp.codeblock(dp.src(["var s = a +? b      // 溢出即报错", "var d = a -? b", "var m = a *? b", "var p = a **? b", "var sh = a <<? b    // 移位量越界即报错"]))
    dp.p("同一能力另有函数形态，便于在不希望中断流程处使用：这类函数返回结果与「是否溢出」两个值，由调用方决定如何处置。")
    dp.codeblock(dp.src(["var (sum, ok) = checked_add(a, b)", "if !ok " + lb() + "", "    println(\"溢出，改用更宽的类型\")", "" + rb() + "", "// 同族：checked_sub / checked_mul / checked_div / checked_shl / checked_shr / checked_neg"]))
    dp.note("两套机制并存是有意设计：运算符形态用于「溢出即异常」的情形，写起来最短；函数形态用于「溢出可预期、需要分支处理」的情形。二者的判定标准完全相同，因此同一表达式在两种写法下结论一致。")

    // ---------------- 3.6 ----------------
    dp.h2("3.6  比较运算")
    dp.p("比较运算符返回布尔值。对文本按码点顺序比较；对元组按分量依次比较。")
    dp.p("连续比较可以链式书写，等价于两两比较再用与运算连接——这使「落在区间内」这类判断读起来与数学写法一致。")
    dp.codeblock(dp.src(["1 == 1          // true", "\"abc\" < \"abd\"    // true", "if 0 <= x < 10 " + lb() + "    // 等价于 (0 <= x) && (x < 10)", "    println(\"在区间内\")", "" + rb() + ""]))
    dp.p("相等比较要求两侧类型相容。语言不为不同类型之间定义隐式相等——这避免了整数与浮点混比时的意外结果。")

    // ---------------- 3.7 ----------------
    dp.h2("3.7  逻辑运算与三值逻辑")
    dp.p("逻辑运算符对布尔生效，并短路求值：与运算在左操作数为假时不再求右操作数，或运算在左操作数为真时不再求右操作数。")
    dp.p("当操作数是三值类型时，同一组运算符按三值逻辑解释：与取较小值、或取较大值、非运算取反。由于三值包含「未知」，与运算中只要有否即为否，或运算中只要有真即为真，未知只在无法决定时才保留。")
    dp.codeblock(dp.src(["var t: trit = unknown_result()", "if t && positive_signal() " + lb() + "", "    // 仅当两者皆正", "" + rb() + ""]))
    dp.p("这组规则的作用是把「未知」当作一等值传播，而不是让它退化成真假之一。三路比较与三态判定都直接受益。")

    // ---------------- 3.8 ----------------
    dp.h2("3.8  位运算")
    dp.p("位运算符作用于整数，移位运算的右操作数是移位数。")
    dp.codeblock(dp.src(["var m = 0b1100 & 0b1010   // 0b1000", "var n = 1 << 4            // 16", "var x = ~0                // 按位取反"]))

    // ---------------- 3.9 ----------------
    dp.h2("3.9  成员判定")
    dp.p("成员判定用于回答「这个键在不在这个结构里」。它是布尔表达式的一部分，可直接用于条件。判定对象可以是映射（判键）、表（判元素）、文本（判子串）。")
    dp.codeblock(dp.src(["if \"alice\" in age " + lb() + "", "    println(\"已知\")", "" + rb() + "", "if \"dave\" not in age " + lb() + "", "    println(\"未见\")", "" + rb() + ""]))
    dp.p("取反形式 not in 是一个整体记号，不写成 !(x in y)——后者在长条件里容易读错。判定成本随容器而异：映射判键是常数时间，表判元素与文本判子串是线性时间。")

    // ---------------- 3.10 ----------------
    dp.h2("3.10  加法的语义扩展")
    dp.p("加号在数值相加之外还有三种扩展，都遵循值语义：产生新值，不修改操作数。")
    var w2 = table_new_i64()
    table_push(w2, 170)
    table_push(w2, 281)
    var h2k = table_new_string()
    table_push(h2k, "形态")
    table_push(h2k, "语义")
    var r2: table<table<string>> = []
    table_push(r2, dp.kvrow("文本 + 标量", "标量转为文本后拼接。左右顺序均可。"))
    table_push(r2, dp.kvrow("表 + 表", "两表元素依序拼接为新表（全量复制）。"))
    table_push(r2, dp.kvrow("映射 + 映射", "合并为新映射；键冲突时右侧覆盖左侧。"))
    dp.tbl(h2k, r2, w2)
    dp.codeblock(dp.src(["var msg = \"n = \" + n            // 文本拼接，免手写转换", "var all = xs + ys              // 表拼接", "var cfg = base + override      // 映射合并，右侧优先"]))

    dp.h3("重复与集合运算")
    dp.p("乘号在文本与表上表示重复，四个位运算记号在容器上按集合语义重载——与整数位运算共享记号，按操作数类型分派，机制与加法的扩展相同。四则运算符取的是「值的集合」语义：按值判定相同，结果保序。")
    dp.codeblock(dp.src(["var sep = \"-\" * 20              // 文本重复", "var grid3 = [0] * 3             // [0, 0, 0]", "var both = a | b                // 并：a 与 b 的全部值", "var core = a & b                // 交：共同拥有", "var diff = a - b                // 差：a 有 b 无", "var flip = a ^ b                // 对称差：仅一方拥有"]))
    dp.p("这组记号只对表与映射定义，触发条件是操作数为容器。需要区分「重复三行的表」与「三个元素」这类边界时，用切片与比较表达，运算符不承担歧义语义。")

    // ---------------- 3.11 ----------------
    dp.h2("3.11  数据流箭头")
    dp.p("箭头是 tie 表达数据流向的主要手段。它把「值经过什么」写成一条自左向右的链，使变换序列的阅读顺序与执行顺序一致。")

    dp.h3("管道")
    dp.p("管道把左侧的值作为右侧调用的输入。嵌套调用与管道写法等价：")
    dp.codeblock(dp.src(["// 嵌套写法", "println(to_string(len(input.trim())))", "", "// 管道写法", "input -> trim -> len -> to_string -> println"]))
    dp.p("当调用还需要额外实参时，被管道的值作为最后一个实参传入。")
    dp.codeblock(dp.src(["10 -> add2(5)      // 等价于 add2(5, 10)"]))

    dp.h3("管道进入容器与字段")
    dp.p("箭头后可以紧跟下标或字段，表示把值送进容器或字段读取。")
    dp.codeblock(dp.src(["var first = t -> [0]        // 等价于 t[0]", "var name = user -> .name    // 等价于 user.name"]))

    dp.h3("管道接运算符")
    dp.p("箭头后可以直接跟一个二元运算符，表示在该值上施加那个运算。它使「在链中间做一次小变换」不必打断链条。")
    dp.codeblock(dp.src(["var grown = t -> + [x]       // 等价于 t + [x]", "var hit = key -> in table    // 等价于 key in table"]))

    dp.h3("块管道")
    dp.p("箭头后跟一个花括号块，块内首个箭头之前的标识符即为绑定名，块内最后一个表达式的值即结果。它用于在链条中间插入一段需要临时变量的计算。")
    dp.codeblock(dp.src(["var r = n -> " + lb() + "", "    v -> v * 2 + 1          // v 是绑定名", "" + rb() + ""]))

    dp.h3("条件管道")
    dp.p("箭头也可以进入条件表达式，用于在链条中分叉。")
    dp.codeblock(dp.src(["var label = score -> score >= 60 ? \"及格\" : \"不及格\""]))

    dp.h3("反向箭头")
    dp.p("反向箭头把右侧的值写入左侧目标，是管道在赋值方向的镜像。它同样支持下标与字段目标。")
    dp.codeblock(dp.src(["x <- 42             // 等价于 x = 42", "arr[0] <- 9         // 等价于 arr[0] = 9", "user.name <- \"ann\"  // 等价于 user.name = \"ann\""]))
    dp.p("左侧目标是容器本身时，反向箭头表示追加：值流入容器尾部。追加返回容器自身，因此可以链式连写。下标写入仍用等号——「把 v 放进 k 位」与「把 v 追加进 t」是两个意图，各用各的记号。")
    dp.codeblock(dp.src(["t <- 1 <- 2 <- 30   // 依次追加，等价于三句 t <- v", "t[0] = 9            // 下标写入仍用等号", "t.pop()             // 取出尾部元素：弹出走方法，不与追加共用记号"]))

    dp.h3("点调用与箭头的分工")
    dp.p("链式书写有两种形态，分工一条划清：点调用表达接收者自身的行为——方法、属性、原地操作；箭头表达把值送进外部的变换——自由函数、表达式、管道。判据是「这件事是谁做的」：对象自己做的用点，外面做的用箭头。")
    dp.codeblock(dp.src(["s.len()             // 自身的行为：点", "t.sort()            // 原地排序：点", "xs -> validate(t)   // 送进外部函数：箭头", "xs.sort() -> count_above(0)   // 先自己的事，再别人的事"]))
    dp.p("二者可以自由衔接：链条从对象自身的行为开始（点），每一步送进外部变换（箭头），需要时再回到点。统一接收者调用规则见 6.4——任何首参为该类型的自由函数都可以写成点形态。")

    dp.h3("箭头用于解构")
    dp.p("反向箭头配合元组形态即解构赋值。")
    dp.codeblock(dp.src(["(lo, hi) <- min_max(xs)", "(q, r) <- divmod(7, 3)"]))

    dp.h3("与短闭包的区分")
    dp.p("形如 标识符 -> 表达式 的写法在两种情况下含义不同：在「要求函数值」的位置是短闭包，其余位置是管道。判据是上下文，而不是符号表。")
    dp.codeblock(dp.src(["var f: fn(i64) -> i64 = t -> t + 1   // 声明位：短闭包", "f = t -> t * 2                        // 赋值位（目标为函数类型）：短闭包", "var v = src -> f                      // 其他位置：管道"]))
    dp.note("箭头承担五种职责（管道、函数返回位、分支臂、短闭包、解构目标），但它们出现的位置互不重叠，因此不会产生歧义。语言不使用第二个箭头记号来表达这些含义——一个记号、五种位置，记忆负担最小。")

    // ---------------- 3.12 ----------------
    dp.h2("3.12  不可变更新")
    dp.p("with 记号为结构或映射生成「复制并覆盖指定成员」的新值。未提及的成员原样保留，且在可能时共享底层数据而不做全量复制。")
    dp.codeblock(dp.src(["var p2 = p with " + lb() + " x: 1 " + rb() + "                 // 结构：复制并覆盖字段", "var t2 = t1 with " + lb() + " k: v " + rb() + "                // 映射：不可变更新", "var t3 = t1 with " + lb() + " a: 1, b: 2 " + rb() + "          // 一次多键", "var t4 = t1 with " + lb() + " a: 1 " + rb() + " with " + lb() + " b: 2 " + rb() + "  // 连续更新"]))
    dp.p("这一记号的价值在于把「基于旧值造新值」写成一行，并明确表达原值不变。没有它时，同样的意图要写若干行赋值，读者还需自行确认原值是否被改动。")

    // ---------------- 3.13 ----------------
    dp.h2("3.13  可空链")
    dp.p("可能缺失的值有三种处理记号：判定是否存在、给出默认值、沿链继续访问。三者配合，使「取值可能为空」这条常见路径不必层层写分支。")
    var w3 = table_new_i64()
    table_push(w3, 150)
    table_push(w3, 301)
    var h3k = table_new_string()
    table_push(h3k, "记号")
    table_push(h3k, "语义")
    var r3: table<table<string>> = []
    table_push(r3, dp.kvrow("expr ?", "取出值；若缺失则立即从当前函数返回（错误向上传播）。"))
    table_push(r3, dp.kvrow("expr ?: 默认值", "取值；若缺失则用右侧表达式。右侧只在缺失时求值。"))
    table_push(r3, dp.kvrow("obj ?. 字段", "安全字段访问；对象缺失则整体为缺失，不继续求值。"))
    table_push(r3, dp.kvrow("obj ?. 方法()", "安全方法调用；同上。"))
    table_push(r3, dp.kvrow("obj ?[ 下标 ]", "安全下标访问；越界或缺失则整体为缺失。"))
    dp.tbl(h3k, r3, w3)
    dp.codeblock(dp.src(["var port = cfg[\"port\"] ?: 8080          // 缺失则取默认", "var city = user?.address?.city ?: \"未填\"  // 沿链安全访问", "var x = parse(s) ?                        // 失败则向上传播"]))
    dp.p("安全链的语义是缺失短路：链上任一环缺失，后续访问不再发生，整个表达式求值为缺失。这既免去了对空值的逐层判断，也避免了「先判断再访问」之间可能出现的状态变化。")

    // ---------------- 3.14 ----------------
    dp.h2("3.14  解引用")
    dp.p("反斜杠作为一元前缀时是解引用记号，作用于指针与引用，取出其所指的值。它只在不安全上下文中可用。")
    dp.codeblock(dp.src(["unsafe " + lb() + "", "    var p = alloc(8)", "    var v = as_i64(\\p)      // 解引用读取", "" + rb() + ""]))
    dp.p("把「此处发生了指针访问」写进表达式，使审计内存访问时可以在文本层面搜索，而不必追踪函数调用的实现。")

    // ---------------- 3.15 ----------------
    dp.h2("3.15  范围与切片")
    dp.p("范围用两个点表示，左闭右开；带等号的形式包含右端点。范围用于循环、分支匹配与切片。")
    dp.codeblock(dp.src(["for i in 0..10 " + lb() + " " + rb() + "      // 0 到 9", "for i in 0..=10 " + lb() + " " + rb() + "     // 0 到 10", "var head = xs[0..3]      // 前三个元素", "var rest = xs[3..]       // 从第四个到尾", "var upto = xs[..2]       // 前两个元素", "var all = xs[..]         // 整个表"]))
    dp.p("切片的三段形式（只给起点、只给终点、两端都省）使「取头部」「取尾部」「取全部」都有最短写法，不必写出冗长的边界表达式。下标越界在运行期报错；切片端点越界则按边界截断。")

    // ---------------- 3.16 ----------------
    dp.h2("3.16  类型判定")
    dp.p("类型判定用于询问一个动态类型值的实际类型，配合分支使用，使分支内的取用是安全的。")
    dp.codeblock(dp.src(["var v: any = 42", "if v is i64 " + lb() + "", "    var n = as_i64(v)", "" + rb() + ""]))
    dp.p("判定与转换分开书写，而不是在判定中隐式完成转换。这样每一处的类型假设都是显式的，阅读时不必回推。")

    // ---------------- 3.17 ----------------
    dp.h2("3.17  集合综合")
    dp.p("综合表达式从一个可遍历的值直接构造新表：方括号内写「元素表达式 for 元素 in 来源」，可选地跟一个筛选条件。变换、筛选、收集在一次书写里完成，与遍历语句同构——会写 for 就会写综合。")
    dp.codeblock(dp.src(["var squares = [x * x for x in 0..10]", "var big = [x for x in xs if x > 100]", "var names = [u.name for u in users if u.active]"]))
    dp.p("综合是普通表达式，可以出现在任何值的位置，也可以嵌套。来源可以是表、映射的键值对、范围，或一切满足遍历约定的类型（见 6.10）。")
    dp.codeblock(dp.src(["var pairs = [(k, v) for k in cfg]", "var flat = [x for row in grid for x in row]   // 嵌套展平"]))
    dp.p("综合立即求值，产出实体表；需要在链中懒式逐元素流动的场合，用迭代器适配（见 6.11）。二者分工：综合负责「一口气造出来」，适配负责「边走边算」。需要映射形态的结果时，对综合结果施加映射转换内建，或直接用键值字面量书写。")
    dp.note("综合与管道是同一件事的两种入口：日常一行能写完的变换用综合；步骤多、需要复用中间名或作用于无限序列时用管道链。语言不比较二者的优劣，按场合选用。")
}

// 构造一行三列
func three(a: string, b: string, c: string) -> table<string> {
    var r: table<string> = [a, b, c]
    return r
}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
