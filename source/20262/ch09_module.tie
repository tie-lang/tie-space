type tie<logic>
// ch09_module.tie —— 规范正文 · 第 9 章 模块与导入
import "F:/Projects/tie-repo/tofflib/spec/pdfdoc.tie" as dp

namespace ch09 {

pub func chapter() {
    dp.h1("第 9 章  模块与导入")

    dp.p("程序由多个文件组成，文件之间通过导入建立依赖。本章说明导入的语法、可见性规则与命名空间的角色。")

    // ---------------- 9.1 ----------------
    dp.h2("9.1  导入")
    dp.p("导入把另一个文件的内容引入当前文件，并可选地给它一个别名。别名用于限定访问，使来源在调用点清晰可见。")
    dp.codeblock(dp.src(["import \"./geometry.tie\" as geo", "import \"./format.tie\"", "", "var d = geo.distance(a, b)"]))
    dp.p("不写别名时，被导入文件的公开名称直接进入当前作用域，适合导入内容很少的文件。来源较多时使用别名，避免名称冲突。路径有两种写法：相对当前文件以 ./ 起头（./geometry.tie），标准库模块以库根起头（/std/string.tie）；两者都写到文件名并带扩展名。")

    // ---------------- 9.2 ----------------
    dp.h2("9.2  命名空间")
    dp.p("命名空间把一组函数组织在同一个名称之下。命名空间可以跨越多个文件：若干文件声明同一个命名空间时，它们的内容合并为一份。")
    dp.codeblock(dp.src(["namespace math " + lb() + "", "    pub func gcd(a: i64, b: i64) -> i64 " + lb() + "", "        if b == 0 " + lb() + " return a " + rb() + "", "        return gcd(b, a % b)", "    " + rb() + "", "" + rb() + ""]))
    dp.p("命名空间可以嵌套，形成层次化的名称。嵌套的层级同时表达归属关系：内层命名空间只在外层可见的范围内被引用。")
    dp.note("跨文件的分片需要由主文件显式导入分片，命名空间才会合并。只在别处导入分片而主文件未导入它，会得到「名称未定义」——这是导入关系的正常结果，不是缺陷。")

    // ---------------- 9.3 ----------------
    dp.h2("9.3  可见性")
    dp.p("声明默认是私有的，只有标注 pub 才对外可见。可见性在导入边界上检查：被导入文件的私有名称不出现在导入方的作用域中。")
    dp.codeblock(dp.src(["func helper() " + lb() + " " + rb() + "        // 仅本文件可见", "pub func api() " + lb() + " " + rb() + "       // 对外可见"]))
    dp.p("私有是本语言在处理跨文件访问时的默认选择。理由很实际：默认私有使得一个文件内部的调整不会意外影响其他文件，公开面需要显式付出决策成本。")

    // ---------------- 9.4 ----------------
    dp.h2("9.4  标准库")
    dp.p("标准库以模块为单位提供。常用模块与其职责如下。")

    var w = table_new_i64()
    table_push(w, 150)
    table_push(w, 301)
    var h = table_new_string()
    table_push(h, "模块")
    table_push(h, "职责")
    var r: table<table<string>> = []
    table_push(r, dp.kvrow("string", "文本查找、切分、替换、大小写"))
    table_push(r, dp.kvrow("utf", "码点与字节的转换、字符分类"))
    table_push(r, dp.kvrow("collection", "表与映射的常用操作"))
    table_push(r, dp.kvrow("sort", "排序与查找"))
    table_push(r, dp.kvrow("math", "数值函数与统计"))
    table_push(r, dp.kvrow("regex", "正则匹配与替换"))
    table_push(r, dp.kvrow("fs", "文件与目录"))
    table_push(r, dp.kvrow("path", "路径拼接与分解"))
    table_push(r, dp.kvrow("json", "数据交换格式的读写"))
    table_push(r, dp.kvrow("time", "时间与日期"))
    table_push(r, dp.kvrow("random", "随机数"))
    table_push(r, dp.kvrow("process", "进程与环境"))
    table_push(r, dp.kvrow("net", "网络通信"))
    table_push(r, dp.kvrow("crypto", "散列与加密"))
    dp.tbl(h, r, w)

    dp.h3("默认可见的内建")
    dp.p("有一批内建不经过导入即可使用：全部内建函数族（len、to_string、str_ 系、sort 系、iter_ 系等，见各章定义），以及结果类型的四个构造名。构造名以裸名提供，书写错误分支时不必每次写全限定名。")
    dp.codeblock(dp.src(["func parse(s: string) -> Result<i64, string> " + lb() + "", "    if s.len() == 0 " + lb() + " return Err(\"空输入\") " + rb() + "", "    return Ok(to_i64(s))", "" + rb() + "", "", "func first(xs: table<i64>) -> Option<i64> " + lb() + "", "    if len(xs) == 0 " + lb() + " return None " + rb() + "", "    return Some(xs[0])", "" + rb() + ""]))
    dp.p("Ok、Err、Some、None 是裸名而非关键字：它们默认可见，也可以被同名声明遮蔽。带限定的全名 Result.Ok 与裸名等价，跨模块书写或需要消除歧义时用全名。")

    // ---------------- 9.5 ----------------
    dp.h2("9.5  依赖与版本")
    dp.p("包管理器按版本解析依赖，并把解析结果与校验信息记录在项目文件中。依赖的引入应当在项目级完成，而不是在源文件中按路径直接引用。")
    dp.codeblock(dp.src(["// 项目文件（tie.pkg）中记录依赖与版本约束", "name: my-project", "require:", "    json    ^2.1", "    net     ~1.4"]))
    dp.p("版本约束使用语义化的范围记号，使得依赖升级的边界在文件里可见。")
    // ---------------- 9.6 ----------------
    dp.h2("9.6  选择性导入与重导出")
    dp.p("导入可以只引入需要的名字，也可以给整个文件起别名，还可以把导入的名字再导出给使用本文件的人。")
    dp.codeblock(dp.src([r"import ""/std/string.tie""                 // 整个模块，用模块名限定访问", r"import ""/std/string.tie"" as str          // 起别名", r"import ""/std/string.tie"".{ join, repeat } // 只引入列出的名字", r"pub import ""/std/json.tie""                // 重导出：使用本文件者也能看到它"]))
    dp.p("选择性导入用于收窄依赖面：文件开头一行即可看出这份代码实际用到了外部模块的哪些能力。重导出用于把若干模块聚合成一个对外入口，使用方只需导入一处。")
    // ---------------- 9.7 ----------------
    dp.h2("9.7  引入命名空间")
    dp.p("using 把某个命名空间的名字直接引入当前作用域，此后引用其中的名字不必再加前缀。")
    dp.codeblock(dp.src([r"using std.args", r"using std.time"]))
    dp.p("它适用于使用频繁、且不会与其他名字冲突的命名空间。作为对照，导入别名不改变名字的可见性——别名只是缩短前缀，读者仍能从调用点看出名字来自哪个模块。是否使用 using 是一个可读性判断：让来源显而易见，比少写几个字符更重要。")
    // ---------------- 9.8 ----------------
    dp.h2("9.8  数据格式")
    dp.p("语言自带一种数据表达格式，用于配置文件、接口描述与数据交换。它的语法就是 tie 的表与字面量语法——不需要学习第二套写法，也不需要为数据单独维护一套解析器。")
    dp.p("格式有两种载体：可读的文本形式与等价的二进制形式。二者表达同一份数据，前者便于阅读与版本对比，后者便于机器读写与传输。同一份定义可以在两种形式间转换，语义不变。")
    dp.codeblock(dp.src([r"// 可读形式：与 tie 的表字面量同形", r"api = [", r"    [ ""id"": ""tsci.linalg"", ""version"": ""0.1.0"" ],", r"    [ ""funcs"": [", r"        [ ""name"": ""mat_mul"", ""in"": 2, ""out"": 1 ],", r"    ],", r"    ],", r"]", r"", r"// 读取：得到一个普通映射，之后按映射规则访问", r"var id = api[0][""id""]"]))
    dp.p("这种格式的定位是生态内的通用数据面：接口定义、构建配置、测试语料都用它表达，因而工具链只需理解一种格式。")
    // ---------------- 9.9 ----------------
    dp.h2("9.9  依赖声明")
    dp.p("项目依赖写在项目文件里，含名称与版本约束。版本约束用语义化的范围记号表达，升级边界因此在文件里可见。源文件本身按模块名导入，不携带版本信息——版本解析是项目级的事，不该散落在各处。")
    dp.codeblock(dp.src([r"// 项目文件（示意）", r"name: my-project", r"require:", r"    json    ^2.1", r"    net     ~1.4", r"    crypto  >=3.0"]))

}

// 左右花括号的字符串形态（展示含花括号的代码示例时用）
func lb() -> string { return str_from_code(123) }
func rb() -> string { return str_from_code(125) }

}
